---
// Earth's route. The globe it draws is `components/Globe.astro`; what this file decides is which
// body that globe is for, and what chrome goes around it.
import Base from "../../layouts/Base.astro";
import Globe from "../../components/Globe.astro";
import MapStylesheet from "../../components/MapStylesheet.astro";
import { BODIES } from "../../lib/bodies";
import { hasHoverHighlight } from "../../lib/globeSubsystems";
import { pageTitle } from "../../lib/pageTitle";

// The chrome this route wears, taken from the registry rather than written as literals.
//
// `borders` is the registry's, because the button is the ONLY way to reach the overlay: a body with
// no boundary data and a borders button has a control that toggles nothing and reports nothing.
// `Globe.astro` reads the same field to decide whether to mount the layers, so the control and the
// thing it controls cannot disagree.
//
// `quality` is deliberately NOT the registry's. That toggle is a property of being a globe page
// rather than of the planet — `rg:quality` is one key across bodies, because a device's tier
// follows the visitor between them.
const body = BODIES.earth;
---

<Base
  title={pageTitle(body.label)}
  description="An interactive globe of ray-traced relief, every country."
  body={body.slug}
  borders={body.hasBorders}
  highlight={hasHoverHighlight(body.slug)}
  quality={true}
  pageRole="globe"
>
  {/* A `Fragment` rather than the `<link>` itself: `slot` reaches `Base` only from a direct child
      written here, so this is the one line that cannot live inside the component it belongs to. */}
  <Fragment slot="head"><MapStylesheet /></Fragment>
  <Globe />
</Base>
