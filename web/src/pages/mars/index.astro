---
// Mars's route. The same globe Earth draws, for the body next door — what this file decides is
// which planet it is and what chrome goes around it.
//
// IT REPLACED A HOLDING PAGE, and `PUBLISHED.mars.relief` is what made that honest: a relief
// pyramid exists, so there is something for a map to draw. What this globe draws is refused or
// allowed by `globeSubsystems` reading the registry, never by a flag written here. Mars now
// publishes all three archives — relief, terrain and a vector pyramid — so the things it still does
// without are the ones no archive can supply: no borders, and no hero panel, since a click is
// hit-tested against the `countries` product and Mars's vector product is `features`. The polar
// caps ARE drawn, and they are relief rather than ice: Mars declares no surface layers, so the two
// discs shade from the same ramps as the tiles.
//
// The four props below are Earth's four and carry Earth's reasoning — `earth.astro` is where it
// is written, and restating it here would be one claim in two places that can disagree. The only
// one that resolves differently is `borders`, and it resolves from the registry, so this page can
// state nothing about it even by accident. `highlight` resolves the same way and happens to agree
// today; both bodies light what the pointer is on, and neither page is what decides that.
import Base from "../../layouts/Base.astro";
import Globe from "../../components/Globe.astro";
import MapStylesheet from "../../components/MapStylesheet.astro";
import { BODIES } from "../../lib/bodies";
import { hasHoverHighlight } from "../../lib/globeSubsystems";
import { pageTitle } from "../../lib/pageTitle";
import { PUBLISHED } from "../../lib/tileAddress";

const body = BODIES.mars;
---

<Base
  title={pageTitle(body.label)}
  description="An interactive globe of ray-traced Martian relief, from the blended MOLA and HRSC elevation model."
  body={body.slug}
  borders={body.hasBorders}
  highlight={hasHoverHighlight(PUBLISHED[body.slug])}
  quality={true}
  pageRole="globe"
>
  {/* A `Fragment` rather than the `<link>` itself: `slot` reaches `Base` only from a direct child
      written here, so this is the one line that cannot live inside the component it belongs to. */}
  <Fragment slot="head"><MapStylesheet /></Fragment>
  <Globe />
</Base>
