---
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";

// Credits are grouped by BODY, not merged into one list, and that is a claim rather than a layout
// choice: the two planets are made of different data under different terms, and a single list would
// invite a reader to assume the Copernicus notice covers both. The output licence does not split —
// one CC BY-SA 4.0 for every image on the site — but the INPUT obligations very much do. The
// group is also what a guard can check — `aboutCredits.test.ts` requires one per registered body,
// because `/mars/` shipped a globe while this page still credited only Earth.
const dataSources = [
  {
    body: "Earth",
    blurb: "Eight datasets fused into one heightfield, then shaded.",
    sources: [
      {
        name: "Copernicus DEM GLO-30",
        href: "https://dataspace.copernicus.eu/explore-data/data-collections/copernicus-contributing-missions/collections-description/COP-DEM",
        role: "Land elevation",
        license: "Copernicus",
        // Verbatim, not paraphrased: Article 6(b) of the WorldDEM-30 licence requires this exact
        // notice for adapted data. ATTRIBUTIONS.md is the source of truth and a test guards the pair.
        attribution:
          "produced using Copernicus WorldDEM-30 © DLR e.V. 2010-2014 and © Airbus Defence and Space GmbH 2014-2018 provided under COPERNICUS by the European Union and ESA; all rights reserved",
      },
      {
        name: "GEBCO 2026 Grid",
        href: "https://www.gebco.net",
        role: "Bathymetry",
        license: "Public domain",
        attribution: "Reproduced from the GEBCO_2026 Grid, GEBCO Compilation Group (2026).",
      },
      {
        name: "GLOBathy",
        href: "https://springernature.figshare.com/collections/GLOBathy_the_Global_Lakes_Bathymetry_Dataset/5243309",
        role: "Lake depth",
        license: "CC0",
        attribution:
          "GLOBathy global lakes bathymetry (Khazaei et al., Sci Data 9:36, 2022). Public-domain dedication (CC0); depth is modelled — see the Lake depth note below.",
      },
      {
        name: "ESA WorldCover 2021",
        href: "https://esa-worldcover.org",
        role: "Snow / ice mask",
        license: "CC-BY 4.0",
        attribution:
          "© ESA WorldCover project 2021 / Contains modified Copernicus Sentinel data (2021), processed by the ESA WorldCover consortium.",
      },
      {
        name: "NSIDC-0791 Snow Persistence",
        href: "https://nsidc.org/data/nsidc-0791",
        role: "Snow persistence",
        license: "Public domain",
        attribution:
          "MODIS snow-persistence climatology (water years 2001–2023), NASA NSIDC DAAC dataset NSIDC-0791.",
      },
      {
        name: "RGI 7.0 Glaciers",
        href: "https://nsidc.org/data/nsidc-0770/versions/7",
        role: "Glaciers",
        license: "CC-BY 4.0",
        attribution:
          "Randolph Glacier Inventory 7.0 (RGI Consortium, 2023), NSIDC-0770 v7. Antarctic region 19 excluded.",
      },
      {
        name: "OSI SAF Sea Ice (OSI-450-a)",
        href: "https://osi-saf.eumetsat.int/products/osi-450-a",
        role: "Sea ice",
        license: "CC-BY 4.0",
        attribution:
          "EUMETSAT Ocean and Sea Ice SAF — Global Sea Ice Concentration Climate Data Record (OSI-450-a), reduced to a 1991–2020 frequency climatology. Copyright EUMETSAT.",
      },
      {
        name: "Natural Earth",
        href: "https://www.naturalearthdata.com",
        role: "Borders & coastlines",
        license: "Public domain",
        attribution: "naturalearthdata.com.",
      },
    ],
  },
  {
    body: "Mars",
    blurb: "One download. No sea, no snow, no borders — the relief is the whole picture.",
    sources: [
      {
        name: "MOLA / HRSC Blended DEM",
        href: "https://astrogeology.usgs.gov/search/map/mars_mgs_mola_mex_hrsc_blended_dem_global_200m",
        role: "Surface elevation",
        // THE PUBLISHER'S OWN WORDS, not our reading of them. USGS states the blend's inputs as
        // "MOLA (CC0) and HRSC (CC BY-SA 3.0 IGO)" and its use constraint as "Please cite authors".
        // Quoting that is the one badge here that needs no interpretation from us. The share-alike
        // half is why the whole site's output licence is BY-SA: whether that label binds is a legal
        // question nobody here can close, so the strict reading is taken and complies either way.
        license: "MOLA CC0 · HRSC CC BY-SA 3.0 IGO",
        attribution:
          "Fergason, R. L, Hare, T. M., & Laura, J. (2018). HRSC and MOLA Blended Digital Elevation Model at 200m v2. Astrogeology PDS Annex, U.S. Geological Survey. MOLA flew on NASA's Mars Global Surveyor and HRSC on ESA's Mars Express; HRSC covers 44% of the planet, MOLA the rest.",
      },
    ],
  },
];

const steps = [
  {
    title: "Fusion",
    text: "Copernicus GLO-30 land elevation is fused with GEBCO bathymetry into one seamless heightfield — the sea floor is part of the picture, so shelves and trenches read as terrain.",
  },
  {
    title: "Render",
    text: "The heightfield drives displacement in Blender's Cycles renderer, lit by a low sun for long relief shadows and coloured by elevation- and depth-keyed ramps.",
  },
  {
    title: "Borders",
    text: "Natural Earth boundaries composite on top as crisp vector lines — never baked into the terrain, so they stay sharp and toggle on demand.",
  },
  {
    title: "Snow",
    text: "A permanent snow / ice mask from ESA WorldCover whitens glaciers and ice caps.",
  },
  {
    title: "Sea ice",
    text: "At the poles, translucent white sea ice floats over the real ocean-floor relief — soft where the ice is seasonal, solid over the permanent pack. It's a 1991–2020 average of how often each stretch of sea freezes, not a live snapshot.",
  },
];

const tools = [
  {
    label: "Rendering",
    html: '<a href="https://www.blender.org" target="_blank" rel="noopener noreferrer">Blender</a> — Cycles, OptiX, OpenImageDenoise',
  },
  { label: "Geoprocessing", html: "GDAL, rasterio, NumPy" },
  {
    label: "Web",
    html: '<a href="https://maplibre.org" target="_blank" rel="noopener noreferrer">MapLibre GL JS</a>, <a href="https://github.com/protomaps/PMTiles" target="_blank" rel="noopener noreferrer">PMTiles</a>',
  },
  {
    label: "Technique",
    html: 'Shaded relief after <a href="https://somethingaboutmaps.wordpress.com/2017/11/16/creating-shaded-relief-in-blender/" target="_blank" rel="noopener noreferrer">Daniel Huffman</a>; aesthetic after <a href="https://frank-ramspott.pixels.com/" target="_blank" rel="noopener noreferrer">Frank Ramspott</a>',
  },
];

// Built as one string: Astro collapses the whitespace around multi-line <a> tags, which twice
// glued a link to the word before it ("is CC BY-SA 4.0" → "isCC BY-SA 4.0").
const licenceHtml = [
  '<strong>Imagery</strong> is <a href="https://creativecommons.org/licenses/by-sa/4.0/"',
  ' target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a> — use it for anything, credit',
  ' Terrella, and share what you make from it under the same license. <strong>Code</strong> is',
  ' <a href="https://opensource.org/license/mit" target="_blank"',
  ' rel="noopener noreferrer">MIT</a>.',
].join("");
---

<Base
  title="About — Terrella"
  description="How Terrella is made: open elevation data, ray-traced relief, and the licenses behind it."
  body="earth"
>
  <Masthead eyebrow="Colophon" heading="About" back="/" maxWidth="min(1500px, 92vw)">
    <p class="lede">
      A ray-traced relief map of every country — rendered from open elevation
      data, not drawn. Warm land, teal seas with real bathymetry, white vector
      borders. A <em>terrella</em> — a "little Earth" — is the model globe early
      scientists spun to study the whole planet at once; this is a modern one,
      and on a capable device it becomes <a href="/earth/">an interactive globe</a>.
    </p>
  </Masthead>

  <main class="about">
    <section class="block">
      <h2 class="eyebrow">How it's made</h2>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li>
              <span class="num">{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="block">
      <h2 class="eyebrow">Data &amp; licenses</h2>
      {
        dataSources.map((group) => (
          <div class="body-group">
            <h3 class="body-head">
              {group.body}
              <span class="body-blurb">{group.blurb}</span>
            </h3>
            <div class="sources">
              {group.sources.map((source) => (
                <article class="source">
                  <h4>
                    <a href={source.href} target="_blank" rel="noopener noreferrer">
                      {source.name}
                    </a>
                  </h4>
                  <p class="role">{source.role}</p>
                  <p class="lic">{source.license}</p>
                  <p class="attr">{source.attribution}</p>
                </article>
              ))}
            </div>
          </div>
        ))
      }
      <p class="legal">
        The organisations in charge of the Copernicus programme by law or by delegation do not incur
        any liability for any use of the Copernicus WorldDEM-30. Terrella is an independent project;
        nothing here is endorsed by ESA, EUMETSAT or the European Union.
      </p>
    </section>

    <div class="note-grid">
      <section class="note-block">
        <h2 class="eyebrow">Using this work</h2>
        <div class="note">
          <p set:html={licenceHtml} />
          <p>
            The data keeps its own licenses, listed above. They travel with whatever you
            make from this.
          </p>
        </div>
      </section>

      <section class="note-block worldview">
        <h2 class="eyebrow">Boundaries</h2>
        <div class="note">
          <p>
            Borders use Natural Earth's <strong>de-facto</strong> worldview everywhere;
            disputed lines are <strong>dashed</strong>. A cartographic default, not a
            political statement — and consistency matters more than any single call, so
            Kashmir keeps its shape whether you arrive from India or Pakistan.
          </p>
          <p>
            It also produces results that look like bugs. Highlight Kazakhstan and a hole
            opens mid-country: the <strong>Baikonur Cosmodrome</strong>, leased to Russia.
            De-facto follows who administers the ground.
          </p>
        </div>
      </section>

      <section class="note-block">
        <h2 class="eyebrow">Lake depth</h2>
        <div class="note">
          <p>
            Lake beds are <strong>modelled, not surveyed</strong>. All 1.43&nbsp;million of
            GLOBathy's lakes get the same synthetic cone, deepening from the shore. Against
            the Caspian's real soundings that model correlates about <strong>0.53</strong>,
            and only <strong>0.8%</strong> of lakes here have a measured depth at all.
          </p>
          <p>
            Modelling them all alike is deliberate: showing only surveyed lakes would draw
            survey funding as geology, since ~85% of them sit in the USA.
          </p>
        </div>
      </section>

      <section class="note-block">
        <h2 class="eyebrow">Mars colour</h2>
        <div class="note">
          <p>
            Mars is coloured <strong>by elevation, not by what it looks like</strong>. Its
            real colouring comes from wind-blown dust, which pays no attention to height —
            so the dark markings you can see from Earth through a small telescope,
            <strong>Syrtis Major</strong> and <strong>Acidalia</strong>, are not here. We
            measured that before choosing: across the elevations holding two thirds of the
            surface, real colour barely shifts, and where it does it disagrees with height
            more often than it agrees.
          </p>
          <p>
            What is taken from the planet is the <strong>hue</strong> — the rust of it,
            measured against a global Viking colour mosaic. What is chosen is that the
            colour <strong>rises with elevation</strong>, so you can read height at a
            glance. Truthfully, Mars is brightest at its highest and its lowest points
            alike: Hellas, the deepest basin, is a dust trap. Drawing it that way would make
            the bottom of the planet look like the top.
          </p>
        </div>
      </section>
    </div>

    <section class="block">
      <h2 class="eyebrow">Tools &amp; technique</h2>
      <dl class="tools">
        {
          tools.map((tool) => (
            <div>
              <dt>{tool.label}</dt>
              <dd set:html={tool.html} />
            </div>
          ))
        }
      </dl>
    </section>

    <footer class="colophon">
      <p>
        Built in collaboration with AI: the pipeline, documentation, and Blender
        render setup were developed with Anthropic's Claude. Data-source
        selection, design, and final review are the author's.
      </p>
    </footer>
  </main>
</Base>

<style>
  .about {
    max-width: min(1500px, 92vw);
    margin: 0 auto;
    padding: 0 clamp(1.1rem, 4vw, 2.5rem) 5rem;
  }
  .lede {
    font-family: var(--serif);
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    line-height: 1.45;
    color: var(--text);
    max-width: 22ch;
    margin: 0.9rem 0 0;
  }
  @media (min-width: 640px) {
    .lede {
      max-width: 44ch;
    }
  }

  .block {
    margin-top: clamp(2rem, 4.5vw, 3rem);
  }

  /* How it's made — a real pipeline, so numbered; a map-sheet process strip */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: clamp(1rem, 2.5vw, 1.8rem);
  }
  .steps li {
    padding-top: 0.9rem;
    border-top: 2px solid var(--line);
  }
  .steps .num {
    font-family: var(--serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
  }
  .steps h3 {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0.15rem 0 0.45rem;
  }
  .steps p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--muted);
  }

  /* Data — grouped by body, then one card per source: name (linked), role, license, attribution.
     The group heading carries its own one-line blurb, so the two planets read as two accounts
     rather than one list that happens to be sorted. */
  .body-group + .body-group {
    margin-top: clamp(1.6rem, 3.5vw, 2.4rem);
  }
  .body-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.7rem;
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 0.7rem;
  }
  .body-blurb {
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--muted);
  }
  .sources {
    display: grid;
    /* `auto-fill`, NOT `auto-fit`, and the difference only shows itself on a small group. auto-fit
       COLLAPSES the tracks an item does not occupy, so Mars's single source stretched to 1420 px
       beside Earth's 269 px cards — a card five times wider than its neighbours reads as a
       different kind of object, and its citation ran to one unreadable line. auto-fill keeps the
       empty tracks, so a lone card is the same width as every other. Measured identical for Earth
       either way: with 8 cards in 5 tracks no track is empty, so the two keywords agree. */
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: clamp(0.8rem, 1.5vw, 1.2rem);
  }
  .source {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    padding: 1.15rem 1.15rem 1.25rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .source h4 {
    font-family: var(--serif);
    font-size: 1.02rem;
    font-weight: 600;
    margin: 0;
  }
  .source h4 a {
    color: inherit;
    text-decoration: none;
  }
  .source h4 a:hover {
    color: var(--accent);
  }
  .source .role {
    margin: 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .source .lic {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 38%, var(--line));
    border-radius: 999px;
    padding: 0.18rem 0.55rem;
    margin: 0.05rem 0;
  }
  .legal {
    margin: clamp(0.9rem, 2vw, 1.3rem) 0 0;
    font-size: 0.72rem;
    line-height: 1.55;
    color: var(--muted);
    max-width: 68ch;
  }
  .source .attr {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* The caveat callouts (licence, worldview, lake depth) sit side by side rather than stacking:
     at 62ch each they left most of a 1500px page empty and pushed the rest below the fold. */
  .note-grid {
    margin-top: clamp(2rem, 4.5vw, 3rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(clamp(280px, 26vw, 380px), 1fr));
    gap: clamp(1.2rem, 2.5vw, 2rem);
    align-items: stretch; /* equal-height callouts — ragged box bottoms read as a mistake */
  }
  .note-block {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Emphasised note — a disclaimer / caveat callout */
  .note {
    max-width: 62ch;
    margin: 0;
    padding: 1rem 1.3rem;
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-2));
    border-radius: 0 10px 10px 0;
    font-size: 0.98rem;
    line-height: 1.6;
  }
  .note-grid .note {
    max-width: none;
    flex: 1;
  }
  /* Paragraphs inside ONE callout, never separate callouts: two adjacent .note boxes met at
     their border-radii and showed a notch between them. */
  .note p {
    margin: 0;
  }
  .note p + p {
    margin-top: 0.7rem;
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: clamp(0.9rem, 2vw, 1.6rem) clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
  }
  .tools > div {
    border-top: 1px solid var(--line);
    padding-top: 0.7rem;
  }
  .tools dt {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .tools dd {
    margin: 0.4rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .colophon {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .colophon p {
    max-width: 62ch;
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
