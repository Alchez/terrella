---
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import Legend from "../components/Legend.astro";
import { ABOUT } from "../lib/aboutContent";
import { BODIES } from "../lib/bodies";
import { bodyRoutes } from "../lib/bodyRoutes";
import { pageTitle } from "../lib/pageTitle";

// THE CONTENT LIVES IN `aboutContent.ts`, NOT HERE. This page used to carry every dataset, step and
// note inline while claiming, through `body="earth"`, to be about one planet — see that module for
// why a third body should be a declaration rather than an edit to this template.
//
// ORDER COMES FROM THE REGISTRY, so the toggle lists planets in the same order as the body switcher
// and a third one needs no edit here either. `Object.values(BODIES)` is the same source that
// component reads.
const worlds = Object.values(BODIES).map((body) => ({
  slug: body.slug,
  label: body.label,
  about: ABOUT[body.slug],
  accent: body.accent,
  // THIS PAGE HOLDS THE SITE'S ONLY CRAWLABLE LINKS TO THE GLOBES, which is a fact about the rest
  // of the site rather than about this one: `.no-js .view-bar` is `display: none` and there is no
  // sitemap integration, so without an ordinary anchor here a globe is unreachable to a crawler
  // and to anyone without JavaScript. It used to be one hand-written `/earth/`, which left Mars
  // orphaned the day it shipped and left nothing watching that; deriving both from the registry
  // is what makes a third planet reachable by existing.
  globe: bodyRoutes(body.slug).globe,
}));

const tools = [
  {
    label: "Rendering",
    html: '<a href="https://www.blender.org" target="_blank" rel="noopener noreferrer">Blender</a>, with Cycles, OptiX and OpenImageDenoise',
  },
  { label: "Geoprocessing", html: "GDAL, rasterio, NumPy" },
  {
    label: "Web",
    html: '<a href="https://maplibre.org" target="_blank" rel="noopener noreferrer">MapLibre GL JS</a>, <a href="https://github.com/protomaps/PMTiles" target="_blank" rel="noopener noreferrer">PMTiles</a>',
  },
  {
    label: "Technique",
    html: 'Shaded relief after <a href="https://somethingaboutmaps.wordpress.com/2017/11/16/creating-shaded-relief-in-blender/" target="_blank" rel="noopener noreferrer">Daniel Huffman</a>; aesthetic after <a href="https://frank-ramspott.pixels.com/" target="_blank" rel="noopener noreferrer">Frank Ramspott</a>',
  },
];

// Built as one string: Astro collapses the whitespace around multi-line <a> tags, which twice
// glued a link to the word before it ("is CC BY-SA 4.0" → "isCC BY-SA 4.0").
const licenceHtml = [
  '<strong>Imagery</strong> is <a href="https://creativecommons.org/licenses/by-sa/4.0/"',
  ' target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>. Use it for anything, credit',
  ' Terrella, and share what you make from it under the same license. <strong>Code</strong> is',
  ' <a href="https://opensource.org/license/mit" target="_blank"',
  ' rel="noopener noreferrer">MIT</a>.',
].join("");
---

{/* `body="earth"` because `BodySlug` has no neutral member and widening it would oblige every
    `Record<BodySlug, …>` in the codebase — the tile registry, the dev store, the body registry —
    to answer for something that is not a planet. What the attribute drives on a `plain` page is the
    chrome accent alone, and this page overrides that below, so nothing downstream reads Earth here.
    `pageRole="plain"` keeps the pre-paint tier guard off it and the body switcher out of it: the
    switcher sends you to a GLOBE, which is the wrong destination from a page whose whole subject is
    the two planets side by side. */}
<Base
  title={pageTitle("About")}
  description="How Terrella is made: open elevation data, ray-traced relief, and the licenses behind it."
  body="earth"
  pageRole="plain"
>
  <Masthead
    eyebrow="Colophon"
    heading="About"
    back="/"
    maxWidth="min(1500px, 92vw)"
    legend={false}
  >
    <p class="lede">
      A <em>terrella</em> is a "little Earth": the model globe early scientists spun to study a
      whole planet at once. This one is ray-traced from open elevation data rather than drawn, and
      there are two of them.
    </p>
  </Masthead>

  <main class="about">
    {/* THE TOGGLE IS RADIO INPUTS, NOT LINKS, and that is two decisions rather than a style.
        Semantically this is a choice between mutually exclusive views, which is what a radio group
        IS — so the keyboard gets arrow-key navigation for free and a screen reader announces the
        set rather than two unrelated links. Mechanically, an `href="#mars"` would move the page:
        the browser scrolls a fragment into view, so switching tabs from halfway down jumps you.
        Radios change no URL and scroll nothing.
        What it costs is deep-linking — nothing can point at Mars's tab. Worth revisiting only if
        something actually needs to. */}
    {
      worlds.map((world, index) => (
        <input
          class="world-input"
          type="radio"
          name="world"
          id={`w-${world.slug}`}
          checked={index === 0}
        />
      ))
    }

    {/* "Which body" is the site's own word for this, straight off the switcher in `Base.astro`.
        This page said "planet" until a third body's plausibility made the difference matter: the
        registry is `BodySlug`, and the Moon is a candidate that "planet" would exclude. */}
    <nav class="worlds" role="radiogroup" aria-label="Which body">
      {
        worlds.map((world) => (
          <label class="world-chip" data-world={world.slug} for={`w-${world.slug}`}>
            <span class="dot" aria-hidden="true" />
            {world.label}
            <span class="sub">
              {world.about.sources.length} source{world.about.sources.length === 1 ? "" : "s"}
            </span>
          </label>
        ))
      }
    </nav>

    {
      worlds.map((world) => (
        <section class="panel" data-world={world.slug} aria-label={world.label}>
          <p class="panel-lede">
            {world.about.lede}{" "}
            <a class="to-globe" href={world.globe}>
              See {world.label} as a globe →
            </a>
          </p>

          <Legend legend={world.about.legend} />

          {world.about.steps.length > 0 && (
            <div class="block">
              <h2 class="eyebrow">How it's made</h2>
              <ol class="steps">
                {world.about.steps.map((step, index) => (
                  <li>
                    <span class="num">{index + 1}</span>
                    <h3>{step.title}</h3>
                    <p>{step.text}</p>
                  </li>
                ))}
              </ol>
            </div>
          )}

          <div class="block">
            <h2 class="eyebrow">Data &amp; licenses</h2>
            <div class="sources">
              {world.about.sources.map((source) => (
                <article class="source">
                  <h4>
                    <a href={source.href} target="_blank" rel="noopener noreferrer">
                      {source.name}
                    </a>
                  </h4>
                  <p class="role">{source.role}</p>
                  <p class="lic">{source.license}</p>
                  <p class="attr">{source.attribution}</p>
                </article>
              ))}
            </div>
            {/* WITH THE SOURCES, NOT IN THE SHARED BLOCK. This is one dataset's licence talking,
                so it sits under the cards that name that dataset; below the tools, where it used
                to be, a reader on either tab had no way to tell which planet it was about. */}
            {world.about.legal.length > 0 && (
              <div class="disclaimer">
                {world.about.legal.map((line) => (
                  <p>{line}</p>
                ))}
              </div>
            )}
          </div>

          {world.about.notes.length > 0 && (
            <div class="note-grid">
              {world.about.notes.map((note) => (
                <section class="note-block">
                  <h2 class="eyebrow">{note.heading}</h2>
                  <div class="note">
                    {note.paragraphs.map((paragraph) => (
                      <p set:html={paragraph} />
                    ))}
                  </div>
                </section>
              ))}
            </div>
          )}
        </section>
      ))
    }

    {/* OUTSIDE THE TOGGLE AND MARKED AS SUCH. The licence, the tools and the liability notice apply
        to the whole site, and a reader who arrived on the Mars tab must not read them as Mars's. */}
    <div class="shared">
      {/* NOT "Both planets", which went stale in two directions at once: it counts the bodies, so a
          third one silently makes it a lie, and it categorises them, so the Moon or Mercury would
          make it a lie without the count ever changing. "Site-wide" says the only thing this mark
          means — that what follows does not vary by tab — and cannot rot. */}
      <p class="shared-mark">Site-wide</p>

      <div class="note-grid">
        <section class="note-block">
          <h2 class="eyebrow">Using this work</h2>
          <div class="note">
            <p set:html={licenceHtml} />
            <p>
              The data keeps its own licenses, listed above. They travel with whatever you make from
              this.
            </p>
          </div>
        </section>
      </div>

      <div class="block">
        <h2 class="eyebrow">Tools &amp; technique</h2>
        <dl class="tools">
          {
            tools.map((tool) => (
              <div>
                <dt>{tool.label}</dt>
                <dd set:html={tool.html} />
              </div>
            ))
          }
        </dl>
      </div>

      <footer class="colophon">
        {/* The independence line belongs here rather than beside the tools: it is a statement about
            the project, and it now covers every publisher instead of naming the three European ones
            that happened to sit next to the Copernicus sentence it was written with. */}
        <p>
          Terrella is an independent project and is not endorsed by any of the organisations whose
          data it uses.
        </p>
        <p>
          Built in collaboration with AI: the pipeline, documentation, and Blender render setup were
          developed with Anthropic's Claude. Data-source selection, design, and final review are the
          author's.
        </p>
      </footer>
    </div>
  </main>
</Base>

<style
  define:vars={{
    earthLight: BODIES.earth.accent.light,
    earthDark: BODIES.earth.accent.dark,
    marsLight: BODIES.mars.accent.light,
    marsDark: BODIES.mars.accent.dark,
  }}
>
  /* THE PAGE'S OWN ACCENT IS NEUTRAL, and the panels below put a planet's back. `data-body` on the
     root stamps Earth's teal over everything, which is right on every other page and wrong here:
     this page is about both planets, so the chrome carries neither and the two tabs own all the
     colour on it. The neutral is the ink desaturated rather than a third hue, so nothing here
     competes with the accents when both chips are on screen at once. */
  .about {
    --accent: #5d564a;
    max-width: min(1500px, 92vw);
    margin: 0 auto;
    padding: 0 clamp(1.1rem, 4vw, 2.5rem) 5rem;
  }
  @media (prefers-color-scheme: dark) {
    .about {
      --accent: #a49b8a;
    }
  }

  .lede {
    font-family: var(--serif);
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    line-height: 1.45;
    color: var(--text);
    max-width: 22ch;
    margin: 0.9rem 0 0;
  }
  @media (min-width: 640px) {
    .lede {
      max-width: 46ch;
    }
  }

  /* Visually hidden but still focusable — `display: none` would take the toggle off the keyboard
     entirely, which is the usual way this pattern is got wrong.
     `position: fixed`, NOT `absolute`, AND THAT IS THE WHOLE NO-SCROLL FIX. Activating a label
     focuses its radio, and the browser scrolls a newly focused element into view; an absolutely
     positioned input sits at the top of `<main>`, so every tab switch yanked the page back to the
     top — measured at 900 → 0. A fixed element is always inside the viewport, so there is nothing
     to scroll to and the page does not move. Same reason the `:target` version was rejected. */
  .world-input {
    position: fixed;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    border: 0;
  }

  .worlds {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin: clamp(1.6rem, 3.5vw, 2.4rem) 0 0;
    padding-top: clamp(1.2rem, 2.5vw, 1.6rem);
    border-top: 1px solid var(--line);
  }

  /* The signature element: two chips, each wearing its OWN body accent. It is the only place on the
     site where both accents appear at once, which is what makes it read as "choose a world" rather
     than as a generic tab bar. */
  .world-chip {
    --chip: var(--muted);
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--chip);
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--chip) 40%, var(--line));
    cursor: pointer;
    transition:
      background 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease;
  }
  .world-chip[data-world="earth"] {
    --chip: var(--earthLight);
  }
  .world-chip[data-world="mars"] {
    --chip: var(--marsLight);
  }
  @media (prefers-color-scheme: dark) {
    .world-chip[data-world="earth"] {
      --chip: var(--earthDark);
    }
    .world-chip[data-world="mars"] {
      --chip: var(--marsDark);
    }
  }
  .world-chip .dot {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: var(--chip);
    flex: none;
    align-self: center;
  }
  .world-chip .sub {
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 400;
    opacity: 0.85;
  }
  .world-chip:hover {
    background: color-mix(in srgb, var(--chip) 10%, transparent);
  }
  /* Focus lands on the input, which is invisible, so the ring has to be drawn on its label. */
  .world-input:focus-visible + .world-input + .worlds .world-chip,
  .world-input:focus-visible + .worlds .world-chip {
    outline: none;
  }
  .world-input:nth-of-type(1):focus-visible ~ .worlds .world-chip[data-world="earth"],
  .world-input:nth-of-type(2):focus-visible ~ .worlds .world-chip[data-world="mars"] {
    outline: 2px solid var(--chip);
    outline-offset: 2px;
  }
  .world-input:nth-of-type(1):checked ~ .worlds .world-chip[data-world="earth"],
  .world-input:nth-of-type(2):checked ~ .worlds .world-chip[data-world="mars"] {
    background: var(--chip);
    border-color: var(--chip);
    color: var(--bg);
  }
  .world-input:nth-of-type(1):checked ~ .worlds .world-chip[data-world="earth"] .dot,
  .world-input:nth-of-type(2):checked ~ .worlds .world-chip[data-world="mars"] .dot {
    background: var(--bg);
  }

  /* EACH PANEL SCOPES `--accent` TO ITS OWN BODY, and that one override is the whole theming
     mechanism: the step numerals, the note borders, the licence pills and the links below all read
     `var(--accent)` already, so they re-tint together and no rule anywhere is per-body. A third
     planet adds a declaration and two lines here. */
  .panel {
    display: none;
  }
  .panel[data-world="earth"] {
    --accent: var(--earthLight);
  }
  .panel[data-world="mars"] {
    --accent: var(--marsLight);
  }
  @media (prefers-color-scheme: dark) {
    .panel[data-world="earth"] {
      --accent: var(--earthDark);
    }
    .panel[data-world="mars"] {
      --accent: var(--marsDark);
    }
  }
  .world-input:nth-of-type(1):checked ~ .panel[data-world="earth"],
  .world-input:nth-of-type(2):checked ~ .panel[data-world="mars"] {
    display: block;
  }

  .panel-lede {
    font-family: var(--serif);
    font-size: clamp(1.02rem, 1.8vw, 1.22rem);
    line-height: 1.5;
    max-width: 54ch;
    margin: clamp(1.4rem, 3vw, 2rem) 0 0;
    color: var(--text);
  }

  .to-globe {
    font-family: var(--sans);
    font-size: 0.86rem;
    white-space: nowrap;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .to-globe:hover {
    border-bottom-color: var(--accent);
  }

  .block {
    margin-top: clamp(2rem, 4.5vw, 3rem);
  }

  /* How it's made — a real pipeline, so numbered; a map-sheet process strip */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: clamp(1rem, 2.5vw, 1.8rem);
  }
  .steps li {
    padding-top: 0.9rem;
    border-top: 2px solid var(--line);
  }
  .steps .num {
    font-family: var(--serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
  }
  .steps h3 {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0.15rem 0 0.45rem;
  }
  .steps p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .sources {
    display: grid;
    /* `auto-fill`, NOT `auto-fit`, and the difference only shows itself when a body has fewer
       sources than the row has tracks. auto-fit COLLAPSES the tracks nothing occupies, so a short
       group stretches its cards several times wider than a full group's beside it — Mars's three
       against Earth's eight is exactly that case, and it once shipped at 1420 px against 269. */
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: clamp(0.8rem, 1.5vw, 1.2rem);
  }
  .source {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    padding: 1.15rem 1.15rem 1.25rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .source h4 {
    font-family: var(--serif);
    font-size: 1.02rem;
    font-weight: 600;
    margin: 0;
  }
  .source h4 a {
    color: inherit;
    text-decoration: none;
  }
  .source h4 a:hover {
    color: var(--accent);
  }
  .source .role {
    margin: 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .source .lic {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 38%, var(--line));
    border-radius: 999px;
    padding: 0.18rem 0.55rem;
    margin: 0.05rem 0;
  }
  .source .attr {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* The caveat callouts sit side by side rather than stacking: at 62ch each they left most of a
     1500px page empty and pushed the rest below the fold. */
  .note-grid {
    margin-top: clamp(2rem, 4.5vw, 3rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(clamp(280px, 26vw, 380px), 100%), 1fr));
    gap: clamp(1.2rem, 2.5vw, 2rem);
    align-items: stretch; /* equal-height callouts — ragged box bottoms read as a mistake */
  }
  .note-block {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .note {
    max-width: none;
    flex: 1;
    margin: 0;
    padding: 1rem 1.3rem;
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-2));
    border-radius: 0 10px 10px 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  /* Paragraphs inside ONE callout, never separate callouts: two adjacent .note boxes met at
     their border-radii and showed a notch between them. */
  .note p {
    margin: 0;
  }
  .note p + p {
    margin-top: 0.7rem;
  }

  /* ONE RULE, AND IT IS THE ONE THAT SAYS SOMETHING. This block used to carry a plain `border-top`
     AND the labelled rule of `.shared-mark` 36px below it, so the reader met two identical hairlines
     stacked with nothing between them. The bare one went: a divider that names what it divides
     ("Both planets") does the same work and answers the question the other one raised. */
  .shared {
    margin-top: clamp(2.6rem, 5.5vw, 3.8rem);
  }
  .shared-mark {
    font-family: var(--mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0 0 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .shared-mark::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .shared .note-grid {
    margin-top: 0;
  }

  /* Set small and quiet, the way a licence notice is read: present, findable, and not competing
     with the credits it hangs off. */
  .disclaimer {
    margin-top: clamp(1rem, 2vw, 1.4rem);
  }
  .disclaimer p {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.55;
    color: var(--muted);
    max-width: 68ch;
  }
  .disclaimer p + p {
    margin-top: 0.5rem;
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
    gap: clamp(0.9rem, 2vw, 1.6rem) clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
  }
  .tools > div {
    border-top: 1px solid var(--line);
    padding-top: 0.7rem;
  }
  .tools dt {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .tools dd {
    margin: 0.4rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .colophon {
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .colophon p {
    max-width: 62ch;
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .colophon p + p {
    margin-top: 0.7rem;
  }
</style>
