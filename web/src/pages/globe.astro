---
import Base from "../layouts/Base.astro";
---

<Base
  title="Terrella — Globe"
  description="An interactive globe of ray-traced relief, every country."
  borders={true}
>
  <div id="globe" class="globe" role="application" aria-label="Interactive relief globe"></div>
  <a class="globe-home" href="/">← Gallery</a>

  <!-- Country detail: populated + revealed on click, framed by fitBounds so the
       flown-to country sits clear of this card. -->
  <aside id="hero-panel" class="hero-panel" hidden aria-hidden="true" aria-label="Country detail">
    <button id="hero-close" class="hp-close" type="button" aria-label="Close">×</button>
    <figure class="hp-figure">
      <img class="hp-hero" alt="" decoding="async" />
      <img class="hp-border" alt="" aria-hidden="true" />
    </figure>
    <div class="hp-body">
      <p class="hp-eyebrow"></p>
      <h2 class="hp-name"></h2>
      <p class="hp-note">
        A ray-traced relief render — softer shadows and heightened terrain than the
        globe's live tiles.
      </p>
      <a class="hp-link" href="/">Open full-size render →</a>
    </div>
  </aside>

  <noscript>
    <p class="globe-noscript">
      The interactive globe needs JavaScript. <a href="/">Browse the gallery instead.</a>
    </p>
  </noscript>
</Base>

<style>
  /* The globe is the page: a fixed, full-viewport map canvas. */
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }
  .globe {
    position: fixed;
    inset: 0;
    background: var(--bg);
  }
  /* Floating "home" chrome, matching the .borders-fab token treatment. */
  .globe-home {
    position: fixed;
    top: 1.2rem;
    left: 1.2rem;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 0.95rem;
    background: color-mix(in srgb, var(--bg-2) 92%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: var(--shadow);
    font-size: 0.9rem;
    color: var(--text);
    text-decoration: none;
  }
  .globe-home:hover {
    color: var(--accent);
  }
  .globe-noscript {
    position: fixed;
    inset: auto 1.2rem 1.2rem;
    z-index: 20;
    margin: 0;
    padding: 1rem 1.2rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--muted);
  }

  /* Country detail card — a floating panel, not a full-screen takeover, so the
     globe stays live behind it. Same token treatment as .globe-home. */
  .hero-panel {
    position: fixed;
    top: 1.2rem;
    right: 1.2rem;
    z-index: 30;
    width: min(420px, calc(100vw - 2.4rem));
    max-height: calc(100vh - 2.4rem);
    overflow: auto;
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--bg-2) 94%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow);
  }
  .hero-panel[hidden] {
    display: none;
  }
  .hp-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    padding: 0;
    font-size: 1.3rem;
    line-height: 1;
    color: var(--text);
    background: color-mix(in srgb, var(--bg-2) 80%, transparent);
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }
  .hp-close:hover {
    color: var(--accent);
  }
  .hp-figure {
    position: relative;
    margin: 0;
    border-radius: 14px 14px 0 0;
    overflow: hidden;
    background: var(--bg);
  }
  .hp-figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* display:block only on the hero — a shared `.hp-figure img` rule would outrank
     `.hp-border`'s display:none and force the border overlay on regardless of the toggle. */
  .hp-hero {
    display: block;
  }
  .hp-border {
    position: absolute;
    inset: 0;
    display: none;
  }
  :global(body.borders-on) .hp-border {
    display: block;
  }
  .hp-body {
    padding: 0.9rem 1.1rem 1.1rem;
  }
  .hp-eyebrow {
    margin: 0 0 0.15rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hp-name {
    margin: 0 0 0.4rem;
    font-family: var(--serif);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text);
  }
  .hp-note {
    margin: 0 0 0.85rem;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--muted);
  }
  .hp-link {
    font-size: 0.9rem;
    color: var(--accent);
    text-decoration: none;
  }
  .hp-link:hover {
    text-decoration: underline;
  }
</style>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import manifest from "../data/countries.json";

  // Data credits (MapLibre requires attribution; matches the About page colophon).
  const CREDITS =
    "Copernicus DEM GLO-30 · GEBCO 2026 · NSIDC-0791 snow · RGI 7.0 glaciers · Natural Earth";
  // The baked polar-cap colour (shade_planet.py CAP_RGB 67,118,132) — used behind
  // the sphere so any gap at the capped poles blends into the disc.
  const DEEP_SEA = "#437684";

  const map = new maplibregl.Map({
    container: "globe",
    style: {
      version: 8,
      // Globe projection is declared in the style (v5 stable) — the proven
      // planet_tiles/index.html viewer does the same with our exact tiles.
      projection: { type: "globe" },
      sources: {
        relief: {
          type: "raster",
          tiles: [location.origin + "/tiles/{z}/{x}/{y}.png"],
          tileSize: 256, // 512px assets served @2x for crisp high-DPI shading
          minzoom: 0,
          maxzoom: 8, // the pyramid ceiling
          attribution: CREDITS,
        },
      },
      layers: [
        { id: "space", type: "background", paint: { "background-color": DEEP_SEA } },
        { id: "relief", type: "raster", source: "relief", paint: { "raster-fade-duration": 0 } },
      ],
    },
    center: [20, 25],
    zoom: 1.6,
    minZoom: 0.4,
    maxZoom: 8, // never reach the z12 globe→mercator auto-switch
    dragRotate: true,
    attributionControl: false, // re-added bottom-left below, clear of the border toggle
  });

  map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), "top-right");
  map.addControl(new maplibregl.GlobeControl(), "top-right"); // globe⇄flat toggle
  map.addControl(new maplibregl.ScaleControl({ maxWidth: 120, unit: "metric" }), "bottom-left");
  map.addControl(new maplibregl.AttributionControl({ compact: true }), "bottom-left");

  // Tiles still in flight when you navigate away (e.g. clicking through to a hero)
  // abort with a network error — expected teardown, not a real failure. Silence those
  // once we're leaving the page, but still surface any genuine map error during use.
  let navigatingAway = false;
  window.addEventListener("pagehide", () => {
    navigatingAway = true;
  });
  map.on("error", (event) => {
    const message = event.error && event.error.message ? event.error.message : "";
    if (navigatingAway && /AJAXError|NetworkError|Failed to fetch/i.test(message)) return;
    console.error("[globe]", event.error);
  });

  // --- Country borders (Natural Earth vector lines) ---------------------------
  // One GeoJSON source; solid international vs dashed disputed/LoC split by a
  // layer filter on FEATURECLA. White "ink" over a dark "casing" so lines read on
  // both pale land and deep sea — MapLibre has no line outline, so the casing is a
  // wider, darker line drawn underneath. Shown/hidden via layer visibility, off
  // the same localStorage key the gallery's border toggle uses.
  const BORDER_KEY = "rg:borders";
  const INTL = "International boundary (verify)";
  const isSolid = ["==", ["get", "FEATURECLA"], INTL];
  const isDashed = ["!=", ["get", "FEATURECLA"], INTL];
  const inkWidth = ["interpolate", ["linear"], ["zoom"], 1, 0.6, 4, 1.0, 8, 1.7];
  // Casing is a real dark halo (wider than the ink, so a dark rim always shows on
  // both sides), softened with a touch of blur — this is what keeps the white line
  // legible over pale highlands and snow, where white-on-white has no contrast.
  const casingWidth = ["interpolate", ["linear"], ["zoom"], 1, 2.2, 4, 3.4, 8, 5.0];
  const casingBlur = ["interpolate", ["linear"], ["zoom"], 1, 0.5, 8, 1.2];
  const BORDER_LAYERS = ["b-casing-solid", "b-casing-dashed", "b-ink-solid", "b-ink-dashed"];
  const bordersOn = () => localStorage.getItem(BORDER_KEY) === "1";

  function addBorders() {
    map.addSource("borders", {
      type: "geojson",
      data: location.origin + "/borders/boundary_lines.geojson",
      maxzoom: 8, // matches the raster pyramid ceiling
      tolerance: 1.2, // thin dense NE geometry at low zoom
      attribution: "Natural Earth",
    });
    const layout = {
      visibility: bordersOn() ? "visible" : "none",
      "line-cap": "round",
      "line-join": "round",
    };
    const casing = { "line-color": "#2b2118", "line-opacity": 0.85, "line-blur": casingBlur };
    const ink = { "line-color": "#ffffff", "line-opacity": 0.95 };
    // Casings first (drawn under), then the white ink on top.
    map.addLayer({ id: "b-casing-solid", type: "line", source: "borders", filter: isSolid,
      layout: { ...layout }, paint: { ...casing, "line-width": casingWidth } });
    map.addLayer({ id: "b-casing-dashed", type: "line", source: "borders", filter: isDashed,
      layout: { ...layout }, paint: { ...casing, "line-width": casingWidth, "line-dasharray": [1.4, 1.0] } });
    map.addLayer({ id: "b-ink-solid", type: "line", source: "borders", filter: isSolid,
      layout: { ...layout }, paint: { ...ink, "line-width": inkWidth } });
    map.addLayer({ id: "b-ink-dashed", type: "line", source: "borders", filter: isDashed,
      layout: { ...layout }, paint: { ...ink, "line-width": inkWidth, "line-dasharray": [2.2, 1.6] } });
  }

  function setBordersVisible(on) {
    for (const id of BORDER_LAYERS) {
      if (map.getLayer(id)) map.setLayoutProperty(id, "visibility", on ? "visible" : "none");
    }
  }

  // The shared floating toggle lives in the Base layout (borders={true}); its
  // localStorage + body-class handling is Base's, we only drive the map layers.
  const borderToggle = /** @type {HTMLInputElement | null} */ (
    document.getElementById("border-toggle")
  );
  borderToggle?.addEventListener("change", () => setBordersVisible(borderToggle.checked));

  // --- Click a country -> fly to it -> show its hero -------------------------
  // The globe is raster, so an invisible fill of the Natural Earth country
  // polygons is the click target. We filter it to our in-scope names (the join
  // is free: manifest name === NE ADMIN), so only rendered countries are
  // hoverable/clickable — everything else is a no-op. The fly-to frame is the
  // authored hero bbox carried in the manifest, so it matches the hero's own
  // framing (metropolitan France, CONUS, etc.).
  const HERO_BASE = "/heroes/";
  const byName = new Map(manifest.countries.map((c) => [c.name, c]));
  const inScope = manifest.countries.map((c) => c.name);
  // Only in-scope (rendered) countries are interactive; reused by every country layer.
  const inScopeFilter = ["in", ["get", "ADMIN"], ["literal", inScope]];
  // Hover highlight: warm gold reads on all three grounds (teal sea, warm sand, white
  // snow) where the teal accent would vanish along coasts; a dark casing carries it
  // over snow, and the hue marks it as an interactive pick, distinct from white borders.
  const HIGHLIGHT_GOLD = "#eca834";
  const HIGHLIGHT_CASING = "#1c140c";
  const whenHovered = ["boolean", ["feature-state", "hover"], false];

  /** srcset w-descriptor is the real pixel WIDTH, not the long edge (portrait
   * variants are narrower than their key) — mirrors the gallery detail page. */
  const variantWidth = (longEdge, aspect) => Math.round(longEdge * Math.min(1, aspect));
  const srcsetFor = (slug, sizes, aspect, border = false) =>
    sizes
      .map((size) => {
        const suffix = border ? `-border-${size}.png` : `-${size}.webp`;
        return `${HERO_BASE}${slug}${suffix} ${variantWidth(size, aspect)}w`;
      })
      .join(", ");

  function addCountries() {
    map.addSource("countries", {
      type: "geojson",
      data: location.origin + "/borders/countries.geojson",
      promoteId: "ADMIN", // feature id = ADMIN string, for feature-state hover
      attribution: "Natural Earth",
    });
    // Invisible except on hover; a warm silhouette wash so the whole landmass lights up.
    map.addLayer({
      id: "country-fill",
      type: "fill",
      source: "countries",
      filter: inScopeFilter,
      paint: {
        "fill-color": HIGHLIGHT_GOLD,
        "fill-opacity": ["case", whenHovered, 0.16, 0],
      },
    });
  }

  // The hovered country's outline — added ABOVE the borders so its edge stays crisp.
  // A soft dark casing under a gold line: the country's boundary (coast + land borders)
  // pops as one glowing silhouette, legible on sea, sand, and snow alike.
  function addCountryHighlight() {
    map.addLayer({
      id: "country-hl-casing",
      type: "line",
      source: "countries",
      filter: inScopeFilter,
      layout: { "line-cap": "round", "line-join": "round" },
      paint: {
        "line-color": HIGHLIGHT_CASING,
        "line-width": ["interpolate", ["linear"], ["zoom"], 0.5, 3.4, 4, 4.8, 8, 6.0],
        "line-blur": 1.2,
        "line-opacity": ["case", whenHovered, 0.5, 0],
      },
    });
    map.addLayer({
      id: "country-hl-line",
      type: "line",
      source: "countries",
      filter: inScopeFilter,
      layout: { "line-cap": "round", "line-join": "round" },
      paint: {
        "line-color": HIGHLIGHT_GOLD,
        "line-width": ["interpolate", ["linear"], ["zoom"], 0.5, 1.8, 4, 2.8, 8, 3.6],
        "line-blur": 0.4,
        "line-opacity": ["case", whenHovered, 1, 0],
      },
    });
  }

  // Hover: pointer + faint tint, only over the (filtered) in-scope fill.
  let hovered = null;
  const clearHover = () => {
    if (hovered !== null) map.setFeatureState({ source: "countries", id: hovered }, { hover: false });
    hovered = null;
  };
  map.on("mousemove", "country-fill", (event) => {
    map.getCanvas().style.cursor = "pointer";
    const id = event.features?.[0]?.id;
    if (id == null || id === hovered) return;
    clearHover();
    hovered = id;
    map.setFeatureState({ source: "countries", id }, { hover: true });
  });
  map.on("mouseleave", "country-fill", () => {
    map.getCanvas().style.cursor = "";
    clearHover();
  });

  // --- The detail card --------------------------------------------------------
  const panel = /** @type {HTMLElement} */ (document.getElementById("hero-panel"));
  const heroImg = /** @type {HTMLImageElement} */ (panel.querySelector(".hp-hero"));
  const borderImg = /** @type {HTMLImageElement} */ (panel.querySelector(".hp-border"));
  const figure = /** @type {HTMLElement} */ (panel.querySelector(".hp-figure"));

  function openPanel(country) {
    panel.querySelector(".hp-eyebrow").textContent = country.continent || "";
    panel.querySelector(".hp-name").textContent = country.name;
    panel.querySelector(".hp-link").setAttribute("href", `/${country.slug}/`);
    figure.style.aspectRatio = String(country.aspect);
    // Card is ~420px wide; ask for a sensibly-sized variant (DPR handled by srcset).
    const sizesAttr = "(max-width: 460px) 92vw, 420px";
    heroImg.src = `${HERO_BASE}${country.slug}-${country.sizes[0]}.webp`;
    heroImg.srcset = srcsetFor(country.slug, country.sizes, country.aspect);
    heroImg.sizes = sizesAttr;
    heroImg.alt = `Ray-traced relief map of ${country.name}`;
    if (country.hasBorder && country.borderSizes.length) {
      borderImg.src = `${HERO_BASE}${country.slug}-border-${country.borderSizes[0]}.png`;
      borderImg.srcset = srcsetFor(country.slug, country.borderSizes, country.aspect, true);
      borderImg.sizes = sizesAttr;
      borderImg.style.removeProperty("display"); // let the body.borders-on rule decide
    } else {
      borderImg.removeAttribute("srcset");
      borderImg.removeAttribute("src");
      borderImg.style.display = "none";
    }
    panel.hidden = false;
    panel.setAttribute("aria-hidden", "false");
  }

  function closePanel() {
    panel.hidden = true;
    panel.setAttribute("aria-hidden", "true");
  }

  document.getElementById("hero-close")?.addEventListener("click", closePanel);
  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !panel.hidden) closePanel();
  });

  function flyToCountry(country) {
    const [west, south, east, north] = country.bbox;
    // Pad the side the card occupies so the country frames in the clear area.
    const wide = window.innerWidth > 640;
    map.fitBounds(
      [[west, south], [east, north]],
      {
        padding: wide
          ? { top: 60, bottom: 60, left: 60, right: 460 }
          : { top: 60, bottom: 60, left: 30, right: 30 },
        maxZoom: 6, // small countries shouldn't slam to the z8 ceiling
        duration: 2200,
        essential: true, // run even under prefers-reduced-motion
      },
    );
  }

  map.on("click", "country-fill", (event) => {
    const name = event.features?.[0]?.properties?.ADMIN;
    const country = name && byName.get(name);
    if (!country) return;
    spinning = false; // a deliberate pick retires the idle spin
    flyToCountry(country);
    openPanel(country);
  });

  map.on("style.load", () => {
    // A soft atmosphere so the sphere reads against the deep-sea background.
    map.setSky({
      "sky-color": "#8fb8d6",
      "horizon-color": "#cbd8dd",
      "fog-color": "#dfe7ea",
      "sky-horizon-blend": 0.5,
      "horizon-fog-blend": 0.5,
      "fog-ground-blend": 0.1,
      "atmosphere-blend": 0.7,
    });
    addCountries(); // fill/hit layer under the borders, so border lines stay on top
    addBorders();
    addCountryHighlight(); // hover outline on top of everything, so the edge stays crisp
  });

  // Gentle idle rotation — a "living globe". Off entirely under reduced-motion,
  // and it retires the moment the visitor takes control. Pausing off the map's
  // own gesture events (not our easeTo) replaces ad-hoc DOM listeners cleanly.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let spinning = !reduceMotion;
  const DEGREES_PER_STEP = 2; // ~one 360° revolution every 3 minutes at 1s steps

  function spin() {
    if (!spinning || map.getZoom() > 3) return;
    const center = map.getCenter();
    center.lng -= DEGREES_PER_STEP;
    map.easeTo({ center, duration: 1000, easing: (progress) => progress });
  }
  for (const gesture of ["dragstart", "rotatestart", "zoomstart", "pitchstart"]) {
    map.on(gesture, () => {
      spinning = false;
    });
  }
  map.on("moveend", spin);
  map.on("load", spin);
</script>
