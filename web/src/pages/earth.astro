---
// Earth's route. The globe it draws is `components/Globe.astro`; what this file decides is which
// body that globe is for, and what chrome goes around it.
import Base from "../layouts/Base.astro";
import Globe from "../components/Globe.astro";
import MapStylesheet from "../components/MapStylesheet.astro";
---

<Base
  title="Terrella — Globe"
  description="An interactive globe of ray-traced relief, every country."
  body="earth"
  borders={true}
  quality={true}
>
  {/* A `Fragment` rather than the `<link>` itself: `slot` reaches `Base` only from a direct child
      written here, so this is the one line that cannot live inside the component it belongs to. */}
  <Fragment slot="head"><MapStylesheet /></Fragment>
  <Globe />
</Base>
