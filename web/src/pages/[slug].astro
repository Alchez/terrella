---
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import data from "../data/countries.json";

// One statically-built page per country.
export function getStaticPaths() {
  return data.countries.map((country) => ({
    params: { slug: country.slug },
    props: { country },
  }));
}

type Country = (typeof data.countries)[number];
const { country: c } = Astro.props as { country: Country };

const HERO_BASE = import.meta.env.PUBLIC_HERO_BASE ?? "/heroes/";
const heroSrcset = c.sizes.map((s) => `${HERO_BASE}${c.slug}-${s}.webp ${s}w`).join(", ");
const borderSrcset = c.borderSizes
  .map((s) => `${HERO_BASE}${c.slug}-border-${s}.png ${s}w`)
  .join(", ");
// Detail view is a single large stage, capped ~1200px; DPR-2 phones still pull
// a sharp variant without fetching the full native frame.
const SIZES = "(max-width: 1240px) 94vw, 1200px";
---

<Base
  title={`${c.name} — Relief Globe`}
  description={`Ray-traced relief map of ${c.name}.`}
  borders={c.hasBorder}
>
  <Masthead heading={c.name} eyebrow={c.continent} back="/" maxWidth="min(1500px, 92vw)" />

  <main class="stage">
    {
      c.rendered ? (
        <figure style={`aspect-ratio:${c.aspect}`}>
          <img
            src={`${HERO_BASE}${c.slug}-${c.sizes[0]}.webp`}
            srcset={heroSrcset}
            sizes={SIZES}
            alt={`Ray-traced relief map of ${c.name}`}
            decoding="async"
            fetchpriority="high"
          />
          {c.hasBorder && (
            <img
              class="border-layer"
              src={`${HERO_BASE}${c.slug}-border-${c.borderSizes[0]}.png`}
              srcset={borderSrcset}
              sizes={SIZES}
              alt=""
              aria-hidden="true"
            />
          )}
        </figure>
      ) : (
        <div class="placeholder" style={`aspect-ratio:${c.aspect}`}>
          <span>{c.name}</span>
          <small>This hero is still rendering — check back soon.</small>
        </div>
      )
    }
    <p class="meta">
      Ray-traced relief · Copernicus GLO-30 + GEBCO bathymetry
      {c.hasBorder && <span> · Natural Earth boundaries</span>}
    </p>
  </main>
</Base>

<style>
  .stage {
    max-width: min(1500px, 92vw);
    margin: 0 auto;
    padding: clamp(1rem, 2vw, 1.4rem) clamp(1.1rem, 4vw, 2.5rem) 3rem;
  }
  .stage figure {
    position: relative;
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-2);
    box-shadow: var(--shadow);
  }
  .stage figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .border-layer {
    position: absolute;
    inset: 0;
    display: none;
  }
  :global(body.borders-on) .border-layer {
    display: block;
  }
  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    text-align: center;
    padding: 2rem;
    border: 1px dashed var(--line);
    border-radius: 12px;
    background: var(--bg-2);
    color: var(--muted);
  }
  .placeholder span {
    font-family: var(--serif);
    font-size: 1.3rem;
    color: var(--text);
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.9rem 0 0;
  }
</style>
