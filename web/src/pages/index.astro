---
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import data from "../data/countries.json";

// Hero variants are served from this base — a symlink in dev (public/heroes ->
// the render store), an nginx static mount in prod. Overridable at build time.
const HERO_BASE = import.meta.env.PUBLIC_HERO_BASE ?? "/heroes/";

type Country = (typeof data.countries)[number];

// Rendered heroes first (so real imagery leads while the sweep fills in), then
// everything else alphabetically.
const countries = [...data.countries].sort(
  (first, second) =>
    Number(second.rendered) - Number(first.rendered) ||
    first.name.localeCompare(second.name),
);

// srcset w-descriptors must be the actual pixel WIDTH, not the long-edge key:
// for a portrait country the file keyed "1920" is only ~450px wide, so
// advertising it as 1920w makes the browser under-select and upscale. aspect is
// w/h, so width = long edge (landscape) or long edge*aspect (portrait).
const variantWidth = (country: Country, longEdge: number) =>
  Math.round(longEdge * Math.min(1, country.aspect));

const srcset = (country: Country) =>
  country.sizes
    .map((longEdge) => `${HERO_BASE}${country.slug}-${longEdge}.webp ${variantWidth(country, longEdge)}w`)
    .join(", ");

const borderSrcset = (country: Country) =>
  country.borderSizes
    .map((longEdge) => `${HERO_BASE}${country.slug}-border-${longEdge}.png ${variantWidth(country, longEdge)}w`)
    .join(", ");

// Displayed at the card's rendered width: ~full width on phones, ~half on
// tablets, ~a third on desktop — keeps the browser from over-fetching.
const SIZES = "(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw";
---

<Base title="Terrella — Gallery" borders={true} quality={true}>
  <Masthead eyebrow="Atlas" heading="Terrella" maxWidth="min(2200px, 94vw)">
    <nav slot="actions" class="head-links">
      <a href="/globe/">Globe</a>
      <a href="/about/">About</a>
    </nav>
    <p class="tagline">
      Ray-traced relief maps of every country.
      <span class="count" id="count">{data.rendered} of {data.count} rendered</span>
    </p>
    <input
      slot="after"
      class="search"
      id="search"
      type="search"
      placeholder="Search countries…"
      autocomplete="off"
      aria-label="Search countries"
    />
  </Masthead>

  <main class="gallery">
    {
      countries.map((country) => (
        <article class="card" data-name={country.name.toLowerCase()} data-rendered={String(country.rendered)}>
          <a class="card-link" href={`/${country.slug}/`}>
          {country.rendered ? (
            <figure style={`aspect-ratio:${country.aspect}`}>
              <img
                src={`${HERO_BASE}${country.slug}-${country.sizes[0]}.webp`}
                srcset={srcset(country)}
                sizes={SIZES}
                alt={`Ray-traced relief map of ${country.name}`}
                loading="lazy"
                decoding="async"
              />
              {country.hasBorder && (
                <img
                  class="border-layer"
                  src={`${HERO_BASE}${country.slug}-border-${country.borderSizes[0]}.png`}
                  srcset={borderSrcset(country)}
                  sizes={SIZES}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                />
              )}
              <figcaption>{country.name}</figcaption>
            </figure>
          ) : (
            <div class="placeholder" style={`aspect-ratio:${country.aspect}`}>
              <span>{country.name}</span>
              <small>rendering…</small>
            </div>
          )}
          </a>
        </article>
      ))
    }
  </main>

  <p class="empty" id="empty" hidden>No countries match that search.</p>
</Base>

<style>
  .tagline {
    color: var(--muted);
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
  }
  .count {
    margin-left: 0.5rem;
    padding-left: 0.6rem;
    border-left: 1px solid var(--line);
    white-space: nowrap;
  }
  .search {
    width: 100%;
    max-width: 720px;
    margin-top: clamp(1.4rem, 3vw, 2rem);
    padding: 0.7rem 0.9rem;
    font: inherit;
    color: var(--text);
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    outline: none;
  }
  .search:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .head-links {
    display: flex;
    gap: 1.1rem;
  }
  .head-links a {
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }
  .head-links a:hover {
    color: var(--accent);
  }

  .gallery {
    max-width: min(2200px, 94vw);
    margin: 0 auto;
    padding: clamp(1.4rem, 3vw, 2rem) clamp(1.1rem, 4vw, 2.5rem) 4rem;
    /* masonry: column *width* drives the count, so more relief cards fill wider
       screens (≈6 columns at 2K, 1 on mobile) without cropping varied aspects. */
    columns: 320px;
    column-gap: clamp(0.8rem, 1.5vw, 1.4rem);
  }
  .card {
    break-inside: avoid;
    margin-bottom: clamp(0.8rem, 1.5vw, 1.4rem);
  }
  .card[hidden] {
    display: none;
  }
  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 10px;
  }
  .card-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .card figure {
    position: relative;
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-2);
    box-shadow: var(--shadow);
  }
  .card figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .border-layer {
    position: absolute;
    inset: 0;
    display: none;
  }
  :global(body.borders-on) .border-layer {
    display: block;
  }
  .card figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.6rem 0.8rem 0.6rem;
    font-family: var(--serif);
    font-size: 0.95rem;
    color: #fff;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent);
  }

  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    text-align: center;
    padding: 1rem;
    border: 1px dashed var(--line);
    border-radius: 10px;
    background: var(--bg-2);
    color: var(--muted);
  }
  .placeholder span {
    font-family: var(--serif);
    font-size: 0.95rem;
    color: var(--text);
  }
  .placeholder small {
    font-size: 0.72rem;
    opacity: 0.7;
  }

  .empty {
    text-align: center;
    color: var(--muted);
    padding: 2rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card figure img {
      transition: transform 0.35s ease;
    }
    .card figure:hover img {
      transform: scale(1.03);
    }
  }
</style>

<script>
  import { probeSignals } from "../lib/capability";
  // Hide the "Globe" masthead link on devices that can't run it — the /globe head
  // guard would only bounce them straight back, so don't offer the dead end.
  const gpu = probeSignals();
  if (!(gpu.webgl2 && !gpu.softwareGpu)) {
    document.querySelector<HTMLAnchorElement>('.head-links a[href="/globe/"]')?.remove();
  }

  const search = document.getElementById("search") as HTMLInputElement | null;
  const count = document.getElementById("count");
  const empty = document.getElementById("empty");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".card"));
  const total = cards.length;
  const baseLabel = count?.textContent ?? "";

  function applyFilter() {
    const query = (search?.value ?? "").trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const match = !query || (card.dataset.name ?? "").includes(query);
      card.hidden = !match;
      if (match) shown++;
    }
    if (count) count.textContent = query ? `${shown} of ${total} shown` : baseLabel;
    if (empty) empty.hidden = shown !== 0;
  }

  search?.addEventListener("input", applyFilter);
</script>
