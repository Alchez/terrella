---
// The site's front page, and the pessimistic Tier-1 default the pre-paint guard steers OFF: a
// capable visitor arriving here is sent to Earth's globe before this paints, and everyone else —
// no WebGL2, `rg:quality` forced to Lite, a crawler, no JavaScript at all — stays and gets the
// gallery. That is why `pageRole` is `lite` on the site root: this page is one of the two URLs
// Earth's lite content answers at, and the guard has to know it.
//
// THE OTHER URL IS `/earth/lite/`, WHICH IS THE CANONICAL ONE FOR THE BODY AND NOT FOR THE SITE.
// `components/Gallery.astro` is the shared body so the two cannot diverge; `BODIES.earth.liteRoute`
// carries why both exist.
import Base from "../layouts/Base.astro";
import Gallery from "../components/Gallery.astro";
---

<Base title="Terrella — Gallery" body="earth" pageRole="lite" spotlight={true} quality={true}>
  <Gallery />
</Base>
