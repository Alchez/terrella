---
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import { manifest as data, type Country } from "../lib/manifest";

// Hero variants are served from this base — a symlink in dev (public/heroes ->
// the render store), an nginx static mount in prod. Overridable at build time.
const HERO_BASE = import.meta.env.PUBLIC_HERO_BASE ?? "/heroes/";

// Rendered heroes first (so real imagery leads while the sweep fills in), then
// everything else alphabetically.
const countries = [...data.countries].sort(
  (first, second) =>
    Number(second.rendered) - Number(first.rendered) ||
    first.name.localeCompare(second.name),
);

// srcset w-descriptors must be the actual pixel WIDTH, not the long-edge key:
// for a portrait country the file keyed "1920" is only ~450px wide, so
// advertising it as 1920w makes the browser under-select and upscale. aspect is
// w/h, so width = long edge (landscape) or long edge*aspect (portrait).
const variantWidth = (country: Country, longEdge: number) =>
  Math.round(longEdge * Math.min(1, country.aspect));

const srcset = (country: Country) =>
  country.sizes
    .map((longEdge) => `${HERO_BASE}${country.slug}-${longEdge}.webp ${variantWidth(country, longEdge)}w`)
    .join(", ");

const spotlightSrcset = (country: Country) =>
  country.spotlightSizes
    .map((longEdge) => `${HERO_BASE}${country.slug}-spotlight-${longEdge}.webp ${variantWidth(country, longEdge)}w`)
    .join(", ");

// Displayed at the card's rendered width: ~full width on phones, ~half on
// tablets, ~a third on desktop — keeps the browser from over-fetching.
const SIZES = "(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw";

// --- Gazetteer index (the atlas's own find-by-name tool; pure links, works with
// no JS, and the browser's native Cmd/Ctrl+F searches its text). The grid above
// stays rendered-first; the index is always the full alphabetical listing.
const alphabetical = [...data.countries].sort((first, second) =>
  first.name.localeCompare(second.name),
);

// A gazetteer entry carries its coordinates: the centroid of the manifest bbox
// [west, south, east, north], rounded to whole degrees with a hemisphere letter.
const coordinates = (country: Country) => {
  const [west, south, east, north] = country.bbox;
  const latitude = (south + north) / 2;
  const longitude = (west + east) / 2;
  const northSouth = `${Math.round(Math.abs(latitude))}° ${latitude >= 0 ? "N" : "S"}`;
  const eastWest = `${Math.round(Math.abs(longitude))}° ${longitude >= 0 ? "E" : "W"}`;
  return `${northSouth}, ${eastWest}`;
};

// Bucket by first letter for the lettered sections + the A–Z jump rail. Insertion
// order follows `alphabetical`, so the letter keys come out already sorted.
const byLetter = new Map<string, Country[]>();
for (const country of alphabetical) {
  const letter = country.name[0].toUpperCase();
  const bucket = byLetter.get(letter);
  if (bucket) bucket.push(country);
  else byLetter.set(letter, [country]);
}
const indexLetters = [...byLetter.keys()];
---

<Base title="Terrella — Gallery" spotlight={true} quality={true}>
  <Masthead eyebrow="Atlas" heading="Terrella" maxWidth="min(2200px, 94vw)">
    <nav slot="actions" class="head-links">
      <a href="/globe/">Globe</a>
      <a href="/about/">About</a>
      <a href="#index">Index</a>
    </nav>
    <p class="tagline">
      Ray-traced relief maps of every country.
      <span class="count">{data.rendered} of {data.count} rendered</span>
    </p>
  </Masthead>

  <main class="gallery">
    {
      countries.map((country) => (
        <article class="card" data-name={country.name.toLowerCase()} data-rendered={String(country.rendered)}>
          <a class="card-link" href={`/${country.slug}/`}>
          {country.rendered ? (
            <figure style={`aspect-ratio:${country.aspect}`}>
              <img
                src={`${HERO_BASE}${country.slug}-${country.sizes[0]}.webp`}
                srcset={srcset(country)}
                sizes={SIZES}
                alt={`Ray-traced relief map of ${country.name}`}
                loading="lazy"
                decoding="async"
              />
              {country.hasSpotlight && (
                <img
                  class="spotlight-layer"
                  src={`${HERO_BASE}${country.slug}-spotlight-${country.spotlightSizes[0]}.webp`}
                  srcset={spotlightSrcset(country)}
                  sizes={SIZES}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                />
              )}
              <figcaption>{country.name}</figcaption>
            </figure>
          ) : (
            <div class="placeholder" style={`aspect-ratio:${country.aspect}`}>
              <span>{country.name}</span>
              <small>rendering…</small>
            </div>
          )}
          </a>
        </article>
      ))
    }
  </main>

  <section class="gazetteer" id="index" role="dialog" aria-label="Country index">
    <div class="gz-bar">
      <div class="gz-head">
        <p class="eyebrow">Index</p>
        <a class="gz-close" href="#" aria-label="Close index">Close ×</a>
      </div>
      <nav class="az-rail" aria-label="Jump to letter">
        {indexLetters.map((letter) => <a href={`#ix-${letter}`}>{letter}</a>)}
      </nav>
    </div>
    <div class="index-groups">
      {
        indexLetters.map((letter) => (
          <section class="letter-group" aria-labelledby={`ix-${letter}`}>
            <h2 class="letter" id={`ix-${letter}`}>
              {letter}
            </h2>
            <ul class="entries">
              {byLetter.get(letter)!.map((country) => (
                <li>
                  <a href={`/${country.slug}/`}>
                    <span class="entry-name">{country.name}</span>
                    <span class="coord">{coordinates(country)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .tagline {
    color: var(--muted);
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
  }
  .count {
    margin-left: 0.5rem;
    padding-left: 0.6rem;
    border-left: 1px solid var(--line);
    white-space: nowrap;
  }
  .head-links {
    display: flex;
    gap: 1.1rem;
  }
  .head-links a {
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }
  .head-links a:hover {
    color: var(--accent);
  }

  .gallery {
    max-width: min(2200px, 94vw);
    margin: 0 auto;
    padding: clamp(1.4rem, 3vw, 2rem) clamp(1.1rem, 4vw, 2.5rem) 4rem;
    /* masonry: column *width* drives the count, so more relief cards fill wider
       screens (≈6 columns at 2K, 1 on mobile) without cropping varied aspects. */
    columns: 320px;
    column-gap: clamp(0.8rem, 1.5vw, 1.4rem);
  }
  .card {
    break-inside: avoid;
    margin-bottom: clamp(0.8rem, 1.5vw, 1.4rem);
  }
  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 10px;
  }
  .card-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .card figure {
    position: relative;
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-2);
    box-shadow: var(--shadow);
  }
  .card figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .spotlight-layer {
    position: absolute;
    inset: 0;
    display: none;
  }
  :global(body.spotlight-on) .spotlight-layer {
    display: block;
  }
  .card figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.6rem 0.8rem 0.6rem;
    font-family: var(--serif);
    font-size: 0.95rem;
    color: #fff;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent);
  }

  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    text-align: center;
    padding: 1rem;
    border: 1px dashed var(--line);
    border-radius: 10px;
    background: var(--bg-2);
    color: var(--muted);
  }
  .placeholder span {
    font-family: var(--serif);
    font-size: 0.95rem;
    color: var(--text);
  }
  .placeholder small {
    font-size: 0.72rem;
    opacity: 0.7;
  }

  /* The gazetteer — the atlas's alphabetical index, every country a link with its
     centroid coordinates. It opens as a full-screen panel over the gallery (tap
     "Index" in the header) so it's reachable from the top on any screen, rather than
     buried below the grid. Pure CSS: :target opens it; :has(:target) keeps it open
     while an A–Z letter anchor is active — so it works with no JavaScript, and the
     browser's Cmd/Ctrl+F searches its text once open. */
  .gazetteer {
    position: fixed;
    inset: 0;
    z-index: 60;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--bg);
    visibility: hidden;
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .gazetteer {
      transition: opacity 0.2s ease, visibility 0.2s ease;
    }
  }
  /* Separate rulesets (not a selector list) so browsers without :has() still honour
     the :target rule and can at least open the panel. */
  .gazetteer:target {
    visibility: visible;
    opacity: 1;
  }
  .gazetteer:has(:target) {
    visibility: visible;
    opacity: 1;
  }
  .gz-bar {
    position: sticky;
    top: 0;
    z-index: 1;
    max-width: min(2200px, 94vw);
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 1.6rem) clamp(1.1rem, 4vw, 2.5rem) 0.4rem;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .gz-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .gz-head .eyebrow {
    margin: 0;
  }
  .gz-close {
    flex: none;
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    padding: 0.4rem 0.1rem 0.4rem 0.6rem;
  }
  .gz-close:hover,
  .gz-close:focus-visible {
    color: var(--accent);
  }
  .az-rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.55rem;
    padding: 0.5rem 0 0.15rem;
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
  }
  .index-groups {
    max-width: min(2200px, 94vw);
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 1.6rem) clamp(1.1rem, 4vw, 2.5rem) 5rem;
  }
  .az-rail a {
    color: var(--muted);
    text-decoration: none;
    padding: 0.1rem 0.15rem;
  }
  .az-rail a:hover,
  .az-rail a:focus-visible {
    color: var(--accent);
  }
  .letter-group {
    margin-bottom: clamp(1.6rem, 3vw, 2.4rem);
    /* clear the sticky bar (head + A–Z rail) when you jump to a letter */
    scroll-margin-top: 6rem;
  }
  .letter {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1;
    color: var(--accent);
    margin: 0 0 0.7rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 260px;
    column-gap: clamp(1.5rem, 3vw, 2.6rem);
  }
  .entries li {
    break-inside: avoid;
  }
  .entries a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.34rem 0;
    text-decoration: none;
    color: var(--text);
    border-bottom: 1px dotted var(--line);
  }
  .entry-name {
    font-size: 0.95rem;
  }
  .coord {
    flex: none;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    white-space: nowrap;
  }
  .entries a:hover .entry-name,
  .entries a:focus-visible .entry-name {
    color: var(--accent);
  }
  .entries a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card figure img {
      transition: transform 0.35s ease;
    }
    .card figure:hover img {
      transform: scale(1.03);
    }
  }
</style>

<script>
  import { probeSignals } from "../lib/capability";
  // Hide the "Globe" masthead link on devices that can't run it — the /globe head
  // guard would only bounce them straight back, so don't offer the dead end.
  const gpu = probeSignals();
  if (!(gpu.webgl2 && !gpu.softwareGpu)) {
    document.querySelector<HTMLAnchorElement>('.head-links a[href="/globe/"]')?.remove();
  }
</script>
