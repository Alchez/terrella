---
import Legend from "./Legend.astro";

interface Props {
  heading: string;
  eyebrow?: string;
  legend?: boolean;
  back?: string; // href for a back link; omit to hide
  backLabel?: string;
  maxWidth?: string; // container width, matched to the page's content
}
const {
  heading,
  eyebrow,
  legend = true,
  back,
  backLabel = "← All countries",
  maxWidth = "1240px",
} = Astro.props;
---

<header class="masthead" style={`--masthead-max:${maxWidth}`}>
  {back && <a class="back" href={back}>{backLabel}</a>}
  <div class="masthead-row">
    <div class="masthead-title">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{heading}</h1>
    </div>
    <slot name="actions" />
  </div>
  <slot />
  {legend && <Legend />}
  <slot name="after" />
</header>

<style>
  .masthead {
    max-width: var(--masthead-max, 1240px);
    margin: 0 auto;
    padding: clamp(1.2rem, 3vw, 2rem) clamp(1.1rem, 4vw, 2.5rem) 0;
  }
  .back {
    display: inline-block;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: clamp(1rem, 3vw, 1.6rem);
  }
  .back:hover {
    color: var(--accent);
  }
  .masthead-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  /* Below 360 px the row cannot hold a title and an actions slot without landing within a few
     pixels of its wrap threshold — and a threshold that close is what cost the gallery a CLS of
     0.328: the header changed height after paint and every card below it moved. Stacking here is
     deterministic, so the masthead's height is a property of the viewport width alone.
     At 320 px the gallery's widths are 117 + 16 + 139 = 272 against 266 available, which fits in
     the fallback serif and does not fit in Fraunces. From 360 px up the slack is 31 px and rising.

     THIS RULE BELONGS TO THIS FILE, not to the page. Astro scopes a component's selectors with a
     generated attribute, so `.masthead-row` here is (0,2,0) while a page's `:global(.masthead-row)`
     is (0,1,0) — a page trying to own this loses to `align-items: flex-end` above and gets a column
     that is still right-aligned. That exact bug shipped for one build and only a screenshot caught
     it; `masthead.test.ts` now asserts the rule lives here. */
  @media (max-width: 359.98px) {
    .masthead-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }
  }
  .masthead-title {
    min-width: 0;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 3.2rem);
    letter-spacing: -0.02em;
    line-height: 1.08;
    margin: 0;
  }
</style>
