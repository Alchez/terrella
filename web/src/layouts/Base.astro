---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Relief Globe",
  description = "Ray-traced relief maps of every country.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #e9e5da;
    --bg-2: #f3f0e8;
    --text: #2c2822;
    --muted: #6b6458;
    --line: #d6d0c2;
    --accent: #3a6e7d; /* deep-sea teal, from the hero ramp */
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 6px 18px rgba(0, 0, 0, 0.08);
    --serif: Georgia, "Times New Roman", serif;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1b1a16;
      --bg-2: #24221b;
      --text: #e7e2d5;
      --muted: #9a9384;
      --line: #35312a;
      --accent: #7cb8b8; /* shallow teal in the dark */
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 22px rgba(0, 0, 0, 0.45);
    }
  }

  * {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    font-family: var(--sans);
    color: var(--text);
    background: var(--bg);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  img {
    display: block;
    max-width: 100%;
  }
  a {
    color: var(--accent);
  }
</style>
