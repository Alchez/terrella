---
import "../styles/global.css";
import { Font } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
  borders?: boolean;
}
const {
  title = "Relief Globe",
  description = "Ray-traced relief maps of every country.",
  borders = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-serif" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {
      borders && (
        <label class="borders-fab" title="Toggle country borders">
          <input type="checkbox" id="border-toggle" />
          <span>Borders</span>
        </label>
      )
    }
  </body>
</html>

<script>
  // Shared border toggle — the floating control lives in the layout so it's
  // always reachable, and its state persists across gallery <-> detail nav.
  const cb = document.getElementById("border-toggle") as HTMLInputElement | null;
  const KEY = "rg:borders";
  if (cb) {
    const on = localStorage.getItem(KEY) === "1";
    cb.checked = on;
    document.body.classList.toggle("borders-on", on);
    cb.addEventListener("change", () => {
      document.body.classList.toggle("borders-on", cb.checked);
      localStorage.setItem(KEY, cb.checked ? "1" : "0");
    });
  }
</script>
