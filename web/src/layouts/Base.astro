---
import "../styles/global.css";
import { Font } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
  borders?: boolean;
  spotlight?: boolean;
  quality?: boolean;
  spin?: boolean;
}
const {
  title = "Terrella",
  description = "Ray-traced relief maps of every country.",
  borders = false,
  spotlight = false,
  quality = false,
  spin = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Progressive-enhancement hook: flip no-js → js before paint so CSS can hide
        controls that only work with JavaScript (see .no-js rules in global.css).
        No JS → the class stays `no-js` and those controls never show. */}
    <script is:inline>
      document.documentElement.classList.replace("no-js", "js");
    </script>
    {/* Pre-paint tier guard: runs synchronously BEFORE the gallery paints, so a
        capable visitor is redirected to /globe with no flash of gallery, and an
        incapable/Lite visitor who deep-links /globe bounces straight back. This
        is the minimal gallery-vs-globe boundary of src/lib/capability.ts
        decideTier() — it can't import (it must run before the bundle), so it is
        deliberately kept tiny and mirrors only that boundary; the nuanced
        globe-vs-full decision + software-GPU check run in the page module. */}
    <script is:inline>
      (function () {
        try {
          var quality = localStorage.getItem("rg:quality") || "auto";
          var path = location.pathname;
          var atEntry = path === "/";
          var atGlobe = path === "/globe" || path === "/globe/";
          if (!atEntry && !atGlobe) return;

          function webgl2() {
            try {
              return !!document.createElement("canvas").getContext("webgl2");
            } catch (e) {
              return false;
            }
          }
          var conn = navigator.connection || {};
          var saveData =
            !!conn.saveData ||
            (typeof matchMedia === "function" &&
              matchMedia("(prefers-reduced-data: reduce)").matches);

          if (atGlobe) {
            // Can't run the globe here, or the user forced Lite → back to gallery.
            if (quality === "lite" || !webgl2()) location.replace("/");
            return;
          }
          // atEntry: steer capable visitors onto the globe, pessimistically.
          if (quality === "lite") return; // user forced the gallery
          if (sessionStorage.getItem("rg:steered")) return; // steer once per session
          if (!webgl2()) return; // no globe floor
          if (quality === "auto" && saveData) return; // respect data-saver on auto
          sessionStorage.setItem("rg:steered", "1");
          location.replace("/globe/");
        } catch (e) {
          /* never let the guard break the page */
        }
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-serif" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {
      /* The view bar — ONE floating pill for every view option, replacing the old
         stack of separate fabs. Toggle buttons (Borders, Spin) and the tier picker
         share a single visual system: filled = on. The hairline divider separates
         what-the-globe-shows from what-tier-you-get. */
      (borders || spotlight || quality || spin) && (
        <div class="view-bar" role="group" aria-label="View options">
          {borders && (
            <button type="button" id="border-toggle" aria-pressed="false" title="Country borders">
              Borders
            </button>
          )}
          {spotlight && (
            <button
              type="button"
              id="spotlight-toggle"
              aria-pressed="false"
              title="Dim everything but this country"
            >
              Focus
            </button>
          )}
          {spin && (
            <button type="button" id="spin-toggle" aria-pressed="false" title="Toggle globe auto-rotate">
              Spin
            </button>
          )}
          {(borders || spotlight || spin) && quality && <span class="view-bar-divider" aria-hidden="true" />}
          {quality && (
            <div class="quality-fab" role="radiogroup" aria-label="Experience quality">
              <button type="button" data-quality="lite" aria-pressed="false">
                Lite
              </button>
              <button type="button" data-quality="globe" aria-pressed="false">
                Globe
              </button>
              <button type="button" data-quality="full" aria-pressed="false">
                Full
              </button>
            </div>
          )}
        </div>
      )
    }
  </body>
</html>

<script>
  // Shared border toggle — the floating control lives in the layout so it's
  // always reachable, and its state persists across gallery <-> detail nav.
  // Off by default: borders are an opt-in overlay, so a fresh visitor gets the
  // clean relief (and, on the globe, never downloads the border geometry — the
  // globe adds that source lazily on the first "rg:borders" on-event below).
  const borderButton = document.getElementById("border-toggle") as HTMLButtonElement | null;
  const KEY = "rg:borders";
  if (borderButton) {
    const applyBorderState = (on: boolean) => {
      borderButton.setAttribute("aria-pressed", String(on));
      document.body.classList.toggle("borders-on", on);
    };
    applyBorderState(localStorage.getItem(KEY) === "1");
    borderButton.addEventListener("click", () => {
      const on = borderButton.getAttribute("aria-pressed") !== "true";
      applyBorderState(on);
      localStorage.setItem(KEY, on ? "1" : "0");
      // Pages with map layers (the globe) react to this, not to the raw click —
      // it keeps the layout as the single writer of the persisted state.
      document.dispatchEvent(new CustomEvent("rg:borders", { detail: { on } }));
    });
  }

  // Focus toggle — dims + desaturates everything but the selected country and
  // strokes its boundary (the subject-spotlight overlay). Same pattern as borders:
  // layout owns the persisted state + the body class the hero pages style against.
  const spotlightButton = document.getElementById("spotlight-toggle") as HTMLButtonElement | null;
  const SPOTLIGHT_KEY = "rg:spotlight";
  if (spotlightButton) {
    const applySpotlightState = (on: boolean) => {
      spotlightButton.setAttribute("aria-pressed", String(on));
      document.body.classList.toggle("spotlight-on", on);
    };
    applySpotlightState(localStorage.getItem(SPOTLIGHT_KEY) === "1");
    spotlightButton.addEventListener("click", () => {
      const on = spotlightButton.getAttribute("aria-pressed") !== "true";
      applySpotlightState(on);
      localStorage.setItem(SPOTLIGHT_KEY, on ? "1" : "0");
    });
  }
</script>

<script>
  // Quality control (Lite / Globe / Full) — the persisted, always-reachable
  // override that beats the auto-probe. The active button reflects the CURRENT
  // experience (the gallery is "Lite"; on the globe it's Globe or Full by whether
  // the idle animation runs), so it reads as "what am I seeing" not "what did the
  // probe guess". A pick persists via setQuality and navigates to that tier's
  // canonical page; the head guard + globe module enforce it from there.
  import { setQuality, currentTier, type Quality } from "../lib/capability";

  const control = document.querySelector<HTMLElement>(".quality-fab");
  if (control) {
    const buttons = Array.from(control.querySelectorAll<HTMLButtonElement>("button"));
    const onGlobe = location.pathname === "/globe" || location.pathname === "/globe/";
    const active: Quality = !onGlobe ? "lite" : currentTier() === "full" ? "full" : "globe";
    for (const button of buttons) {
      const isActive = button.dataset.quality === active;
      button.classList.toggle("is-active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    }
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const choice = button.dataset.quality as Quality;
        setQuality(choice);
        // Let the new choice steer this session even if we already auto-steered once.
        try {
          sessionStorage.removeItem("rg:steered");
        } catch (e) {
          /* private mode — ignore */
        }
        const target = choice === "lite" ? "/" : "/globe/";
        if (location.pathname === target) location.reload();
        else location.assign(target);
      });
    }
  }
</script>
