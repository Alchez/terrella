---
import "../styles/global.css";
import { Font } from "astro:assets";
import { BODIES, type BodySlug } from "../lib/bodies";
import { bodyRoutes } from "../lib/bodyRoutes";

interface Props {
  title?: string;
  description?: string;
  borders?: boolean;
  spotlight?: boolean;
  quality?: boolean;
  /** The cursor button that switches the hover highlight off — see `highlightPreference.ts`.
   *
   *  From the registry rather than from being a globe page, for the reason `borders` is: the paint
   *  it governs hangs off a body's vector overlay, so a body publishing none would get a control
   *  that toggles nothing. `hasHoverHighlight` is the one place that condition is written. */
  highlight?: boolean;
  /** Which body this page is dressed in — see `lib/bodies.ts`.
   *
   *  REQUIRED, WITH NO DEFAULT, and `astro check` is what enforces it: a page that omitted it
   *  would render with no accent at all rather than quietly wearing Earth's. That is the whole
   *  design. A default here is invisible in the diff that adds the second body's page, and the
   *  result — a Mars view in Earth's teal — is the kind of wrong that ships. */
  body: BodySlug;
  /** What this page IS to the tier guard below: a body's globe, a body's lite page, or neither.
   *
   *  IT IS DECLARED RATHER THAN DERIVED FROM THE PATH, and that is the whole of this prop. The
   *  guard used to ask "does `location.pathname` equal this body's lite route" — a proxy that was
   *  exact while each of a body's two pages had exactly one URL, and that broke the moment Earth's
   *  lite content answered at both `/` and `/earth/lite/`. Moving `liteRoute` to the second of
   *  those silently deleted the steer off the first: `/` matched neither route, so the guard
   *  returned before reading anything, and a capable visitor landing on the site's front page was
   *  never sent to the globe again. Seven guard tests fail on that flip, which is how it was found.
   *
   *  A page knows what it is. A URL only knows how it was spelled — which is also why this retires
   *  the guard's copy of `isSamePath`: `/earth` and `/earth/` are one page and now say so
   *  themselves, rather than being compared into agreement by a rule written twice.
   *
   *  REQUIRED, LIKE `body`, AND FOR A SHARPER REASON. Every value is a real answer, `"plain"`
   *  included, so there is no sensible default to fall back to — and the failure a default would
   *  buy is the guard doing NOTHING on a page that needed it: a visitor with no WebGL2 left sitting
   *  on a globe their device cannot draw, on a page that renders perfectly in development.
   *
   *  IT ALSO DECIDES WHO GETS THE BODY SWITCHER, which is a second job and deliberately not a
   *  second prop. "Belongs to a body" is exactly what the two non-`plain` values say, so a
   *  `switcher` boolean would be that set written again beside the declaration it copies — true on
   *  the same five pages, and free to fall out of step with them silently. */
  pageRole: "globe" | "lite" | "plain";
}
const {
  title = "Terrella",
  description = "Ray-traced relief maps of every country.",
  borders = false,
  spotlight = false,
  quality = false,
  highlight = false,
  body,
  pageRole,
} = Astro.props;

// The two pages this body has. Stamped onto the root element below because the pre-paint guard
// needs them and cannot import — see bodyRoutes.ts. This is the single point where the registry
// becomes the DOM, so the guard reads facts rather than restating them, and a third planet
// changes no script.
const routes = bodyRoutes(body);
---

<!doctype html>
{/* `data-body` selects this page's token block in global.css. Server-rendered onto the element the
    tokens are declared on, so the accent is correct in the first painted frame — a class flipped by
    script would repaint the chrome after paint, which is the CLS this site has already paid for.

    The role and the two routes ride the same element for a different reason: they are the pre-paint
    guard's only input, and an attribute is the one channel that is already parsed before any script
    runs. Both routes are stamped on every page, `plain` ones included — the guard reads them only
    after the role has let it through, and a tag whose shape depends on the role is one more thing
    for a source scan to have to know. */}
<html
  lang="en"
  class="no-js"
  data-body={body}
  data-page-role={pageRole}
  data-globe-route={routes.globe}
  data-lite-route={routes.lite}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* GPU memory accounting, DEV ONLY — see `webglMemoryDevTool` in astro.config.ts for why it
        cannot be an import. It must patch `getContext` before MapLibre builds one, so it is a
        classic script the platform runs ahead of every deferred module script.

        The guard is evaluated at BUILD time, so production HTML never carries the tag and the
        route serving it does not exist outside `astro dev` either. Vite's `transformIndexHtml`
        was tried first and is silently inert here: Astro renders page HTML itself and never runs
        that hook, so the tag simply never appeared while the route answered 200. */}
    {import.meta.env.DEV && <script is:inline src="/__webgl-memory.js"></script>}
    {/* Progressive-enhancement hook: flip no-js → js before paint so CSS can hide
        controls that only work with JavaScript (see .no-js rules in global.css).
        No JS → the class stays `no-js` and those controls never show. */}
    <script is:inline>
      document.documentElement.classList.replace("no-js", "js");
    </script>
    {/* Pre-paint tier guard: runs synchronously BEFORE the page paints, so a
        capable visitor is redirected to this body's globe with no flash of the
        page they landed on, and an incapable/Lite visitor who deep-links that
        globe bounces straight back. This is the minimal lite-vs-globe
        boundary of src/lib/capability.ts decideTier() — it can't import (it must
        run before the bundle), so it is deliberately kept tiny and mirrors only
        that boundary: the same WebGL2 + software-rasterizer floor `capable()`
        applies. The nuanced globe-vs-full decision (memory, network,
        reduced-motion) still runs in the page module.

        WHAT this page is, and which two routes it sits between, are read off the
        root element rather than written here. The routes used to be the literal
        `/earth`, which was right while there was one globe and silently wrong
        the moment there were two. The ROLE replaced a path comparison for the
        same shape of reason one step later — see the `pageRole` prop above. */}
    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          // The page's own answer, and the guard's entire dispatch. `plain` and any unrecognised
          // value alike fall out here, which is the behaviour `/about/` and a country page want.
          var role = root.getAttribute("data-page-role");
          if (role !== "globe" && role !== "lite") return;
          var quality = localStorage.getItem("rg:quality") || "auto";
          var globeRoute = root.getAttribute("data-globe-route");
          var liteRoute = root.getAttribute("data-lite-route");

          // MUST mirror capability.ts `capable()` — WebGL2 present AND not a software
          // rasterizer. It cannot import it (this has to run before the bundle, which is the
          // whole reason it is is:inline), so the two are pinned against each other by
          // capability.test.ts, which executes THIS source rather than string-matching it.
          //
          // The software check used to be missing here, so a SwiftShader/llvmpipe visitor who
          // deep-linked /earth was never bounced: the page module would decide "gallery" while
          // this guard had already let the globe render. Reading both renderer strings covers
          // Chrome (truth in the debug extension, RENDERER masked) and Firefox (extension
          // deprecated, RENDERER unmasked).
          //
          // It stays INSIDE the guard rather than being hoisted: "the outer scope" here is the
          // page, and this whole script is `is:inline` precisely so it runs before any bundle
          // exists to hoist into. Moving it out would either put it in a module that loads too
          // late to bounce anyone, or widen this inline block's footprint on every page.
          // oxlint-disable-next-line unicorn/consistent-function-scoping
          function capable() {
            try {
              var gl = document.createElement("canvas").getContext("webgl2");
              if (!gl) return false;
              var names = [];
              var ext = gl.getExtension("WEBGL_debug_renderer_info");
              if (ext) names.push(String(gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) || ""));
              names.push(String(gl.getParameter(gl.RENDERER) || ""));
              return !/swiftshader|llvmpipe|software|basic render|microsoft basic|softpipe|mesa offscreen/i.test(
                names.join(" "),
              );
            } catch (e) {
              return false;
            }
          }
          var conn = navigator.connection || {};
          var saveData =
            !!conn.saveData ||
            (typeof matchMedia === "function" &&
              matchMedia("(prefers-reduced-data: reduce)").matches);

          if (role === "globe") {
            // Can't run the globe here, or the user forced Lite → back to this body's own fallback.
            if (quality === "lite" || !capable()) location.replace(liteRoute);
            // Reaching the globe by ANY route counts as steered — not just by the auto-steer
            // below. The flag means "this session has seen the globe", so a later arrival on a
            // lite page is a deliberate choice and must not be bounced straight back. What made
            // this concrete was the globe's own `← Gallery` link, now deleted; the claim outlives
            // it, because the lite pages' own back links and any external link into `/` land the
            // same way, and writing the flag only on the auto-steer path makes every one of them
            // a no-op for anyone who deep-linked a globe or picked Globe/Full in the view bar.
            else sessionStorage.setItem("rg:steered", "1");
            return;
          }
          // A lite page: steer capable visitors onto THIS body's globe, pessimistically.
          if (quality === "lite") return; // user forced the lite view
          if (sessionStorage.getItem("rg:steered")) return; // steer once per session
          if (!capable()) return; // no globe floor — same test capability.ts applies
          if (quality === "auto" && saveData) return; // respect data-saver on auto
          sessionStorage.setItem("rg:steered", "1");
          location.replace(globeRoute);
        } catch (e) {
          /* never let the guard break the page */
        }
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-serif" />
    <title>{title}</title>
    {/* For stylesheets a page wants discovered by the preload scanner but NOT blocking paint.
        A page could put the same <link> in its own body and the scanner would still find it, but
        a stylesheet in the body is the kind of thing a later reader "tidies" back into the head
        without knowing it was deliberate. Named, so the gallery does not inherit the globe's. */}
    <slot name="head" />
  </head>
  <body>
    {
      /* WHICH WORLD — one floating pill, top-centre, in a group of its own. The layout already
         states the taxonomy the other clusters divide up: the view bar is what the globe SHOWS,
         the globe's top-right rail is where you look FROM, its top-left row is ways OFF. Which
         planet you are on is a fourth question, not a member of any of those.

         ON EVERY PAGE A BODY OWNS, DERIVED AND NOT OPTED IN — see `pageRole` above for why this
         is not its own prop.

         NO CLIENT SCRIPT, AND THAT IS A DECISION ABOUT WHO OWNS THE TIER. Each href is that
         body's globe, and the destination's own pre-paint guard resolves the tier on arrival —
         so a visitor forced to Lite lands on the other body's lite page without this control
         reading `rg:quality` at all. Rewriting the href from the stored preference would put a
         second reader on the decision `bodyRoutes.ts` exists to own, and it would be the reader
         that is wrong first: it runs at BUILD time, where nobody has a preference yet.

         FIRST IN THE BODY, so the keyboard reaches it without crossing the page. Last would put
         it behind every card in the gallery. */
      pageRole !== "plain" && (
        <nav class="body-switcher" aria-label="Which body">
          {Object.values(BODIES).map((entry) => (
            <a
              href={bodyRoutes(entry.slug).globe}
              aria-current={entry.slug === body ? "true" : undefined}
            >
              {entry.label}
            </a>
          ))}
        </nav>
      )
    }
    <slot />
    {
      /* The view bar — ONE floating pill for what the globe SHOWS. Layer toggles (Borders,
         Focus) and the tier picker share a single visual system: filled = on. The hairline
         divider separates what-the-globe-shows from what-tier-you-get.

         CAMERA CONTROLS DO NOT BELONG IN HERE. This bar holds what you are looking AT; the
         globe's top-right rail holds where you are looking FROM. Anything that moves or frames
         the camera goes in the rail (see railControls.ts) — putting it here would sort controls
         by which layer built them rather than by what they do. */
      (highlight || borders || spotlight || quality) && (
        // DO NOT ADD A PHONE COLLAPSE. The controls measure 229.7 px and the bar is allowed
        // 281.6 px at 320 px, so they sit on one row at every width the site serves — and a
        // trigger costs more than it saves: adding one back puts 320 px onto two rows, because
        // trigger-plus-controls is what does not fit there, not the controls.
        //
        <div class="view-bar">
          <div class="view-bar-items" id="view-bar-items" role="group" aria-label="View options">
          {/* FIRST IN THE ROW, and an icon where its neighbours are words. Both were ratified,
              judged on a preview of the real pill. The icon is also what makes a fourth control
              affordable at 320px, where a label would have spent the row's remaining space.

              THE GLYPH IS INLINE SVG ON `currentColor`, not the rail's CSS-mask idiom. The rail
              masks because MapLibre owns those buttons and hands us only a span; we own this
              markup, so the pressed state's colour comes free from the same rule that recolours
              the text buttons. Filled rather than stroked because everything beside it is text —
              solid ink — and an outline glyph reads lighter than its own row. */}
          {highlight && (
            <button
              type="button"
              id="highlight-toggle"
              class="icon-btn"
              aria-pressed="true"
              aria-label="Highlight what the pointer is on"
              title="Highlight what the pointer is on"
            >
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M5.4 5.2 11.1 18.8 13 13.3 18.6 11.3Z" />
              </svg>
            </button>
          )}
          {borders && (
            <button type="button" id="border-toggle" aria-pressed="false" title="Country borders">
              Borders
            </button>
          )}
          {spotlight && (
            <button
              type="button"
              id="spotlight-toggle"
              aria-pressed="false"
              title="Dim everything but this country"
            >
              Focus
            </button>
          )}
          {(highlight || borders || spotlight) && quality && (
            <span class="view-bar-divider" aria-hidden="true" />
          )}
          {/* Tooltips describe what each tier DOES TODAY, not what the architecture plans for it.
              `currentTier()` has exactly one behavioural read in the whole site — earth.astro's
              `spinning` — so Full currently buys idle rotation and nothing else. Saying "3D
              terrain" here would advertise a promise the site does not yet keep. Revisit when
              something else reads the tier. */}
          {quality && (
            <div class="quality-fab" role="radiogroup" aria-label="Experience quality">
              <button
                type="button"
                data-quality="lite"
                aria-pressed="false"
                title="Still renders only — leaves the globe"
              >
                Lite
              </button>
              <button type="button" data-quality="globe" aria-pressed="false" title="Interactive globe">
                Globe
              </button>
              <button
                type="button"
                data-quality="full"
                aria-pressed="false"
                title="Interactive globe with raised terrain, auto-rotating when idle"
              >
                Full
              </button>
            </div>
          )}
          </div>
        </div>
      )
    }
  </body>
</html>

<script>
  // The hover-highlight toggle. Same split as Borders below — the layout owns the persisted state
  // and broadcasts, the globe reacts to the event rather than to the click — but the key, the
  // default and the event name come from `highlightPreference.ts` instead of being spelled here,
  // because the globe has to read the same three and Borders' way of doing that is two copies.
  //
  // NO BODY CLASS. Focus toggles one because CSS on the hero pages styles against it; this one has
  // no CSS to drive, and a class nothing reads is a second source of truth waiting for someone to
  // start believing it.
  import {
    HIGHLIGHT_EVENT,
    HIGHLIGHT_KEY,
    highlightEnabled,
    highlightStorageValue,
    type HighlightChange,
  } from "../lib/highlightPreference";

  const highlightButton = document.getElementById("highlight-toggle") as HTMLButtonElement | null;
  if (highlightButton) {
    const applyHighlightState = (on: boolean) => {
      highlightButton.setAttribute("aria-pressed", String(on));
    };
    // The markup ships `aria-pressed="true"` because the default is ON, so a visitor who never
    // touched it sees the right state before this runs. This call is what corrects the one who did.
    applyHighlightState(highlightEnabled());
    highlightButton.addEventListener("click", () => {
      const on = highlightButton.getAttribute("aria-pressed") !== "true";
      applyHighlightState(on);
      localStorage.setItem(HIGHLIGHT_KEY, highlightStorageValue(on));
      const detail: HighlightChange = { on };
      document.dispatchEvent(new CustomEvent(HIGHLIGHT_EVENT, { detail }));
    });
  }

  // Shared border toggle — the floating control lives in the layout so it's
  // always reachable, and its state persists across gallery <-> detail nav.
  // Off by default: borders are an opt-in overlay, so a fresh visitor gets the
  // clean relief (and, on the globe, never downloads the border geometry — the
  // globe adds that source lazily on the first "rg:borders" on-event below).
  const borderButton = document.getElementById("border-toggle") as HTMLButtonElement | null;
  const KEY = "rg:borders";
  if (borderButton) {
    const applyBorderState = (on: boolean) => {
      borderButton.setAttribute("aria-pressed", String(on));
    };
    applyBorderState(localStorage.getItem(KEY) === "1");
    borderButton.addEventListener("click", () => {
      const on = borderButton.getAttribute("aria-pressed") !== "true";
      applyBorderState(on);
      localStorage.setItem(KEY, on ? "1" : "0");
      // Pages with map layers (the globe) react to this, not to the raw click —
      // it keeps the layout as the single writer of the persisted state.
      document.dispatchEvent(new CustomEvent("rg:borders", { detail: { on } }));
    });
  }

  // Focus toggle — dims + desaturates everything but the selected country and
  // strokes its boundary (the subject-spotlight overlay). Same pattern as borders:
  // layout owns the persisted state + the body class the hero pages style against.
  const spotlightButton = document.getElementById("spotlight-toggle") as HTMLButtonElement | null;
  const SPOTLIGHT_KEY = "rg:spotlight";
  if (spotlightButton) {
    const applySpotlightState = (on: boolean) => {
      spotlightButton.setAttribute("aria-pressed", String(on));
      document.body.classList.toggle("spotlight-on", on);
    };
    applySpotlightState(localStorage.getItem(SPOTLIGHT_KEY) === "1");
    spotlightButton.addEventListener("click", () => {
      const on = spotlightButton.getAttribute("aria-pressed") !== "true";
      applySpotlightState(on);
      localStorage.setItem(SPOTLIGHT_KEY, on ? "1" : "0");
    });
  }
</script>

<script>
  // Quality control (Lite / Globe / Full) — the persisted, always-reachable
  // override that beats the auto-probe. The active button reflects the CURRENT
  // experience (the gallery is "Lite"; on the globe it's Globe or Full by whether
  // the idle animation runs), so it reads as "what am I seeing" not "what did the
  // probe guess". A pick persists via setQuality and navigates to that tier's
  // canonical page; the head guard + globe module enforce it from there.
  import { setQuality, currentGlobeTier, type Quality } from "../lib/capability";
  import { currentBody } from "../lib/currentBody";
  import { bodyRoutes, isSamePath } from "../lib/bodyRoutes";

  const control = document.querySelector<HTMLElement>(".quality-fab");
  if (control) {
    const buttons = Array.from(control.querySelectorAll<HTMLButtonElement>("button"));
    // THIS body's two pages, not Earth's. This script is a module and can import, so it asks the
    // registry directly where the pre-paint guard above has to read the same answer off an
    // attribute — the asymmetry is forced by `is:inline`, not chosen.
    const routes = bodyRoutes(currentBody().slug);
    const onGlobe = isSamePath(location.pathname, routes.globe);
    // `currentGlobeTier`, and only reached when `onGlobe`: it cannot return `gallery` for a soft
    // signal, which is what makes the collapse below lossless rather than merely tidy. The plain
    // `currentTier()` CAN, and this line used to fold that into "globe" silently — so a probe
    // saying "this device cannot run the globe" and a probe saying "capable, skipping the extras"
    // lit the same chip, and the first one went unnoticed on a globe running at 243 fps.
    const active: Quality = !onGlobe ? "lite" : currentGlobeTier() === "full" ? "full" : "globe";
    for (const button of buttons) {
      const isActive = button.dataset.quality === active;
      button.classList.toggle("is-active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    }
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const choice = button.dataset.quality as Quality;
        setQuality(choice);
        // No sessionStorage juggling here on purpose. This used to clear "rg:steered" so a new
        // choice could steer the session again, but nothing needs that: every arrival at /earth
        // is already permitted by rg:quality alone, and every arrival at / with quality "lite"
        // returns early from the head guard. Clearing it only re-armed the auto-steer, which
        // then hijacked the next deliberate navigation back to a lite page.
        // Both destinations belong to the body whose page this is, so Globe and Full can no longer
        // navigate a Mars visitor to Earth. `isSamePath` rather than `===` for the same reason the
        // guard uses it: reached by the other trailing-slash spelling, this used to `assign` the
        // page it was already on — a real navigation where a reload was meant.
        const target = choice === "lite" ? routes.lite : routes.globe;
        if (isSamePath(location.pathname, target)) location.reload();
        else location.assign(target);
      });
    }
  }
</script>
