---
import "../styles/global.css";
import { Font } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
  borders?: boolean;
  spotlight?: boolean;
  quality?: boolean;
  spin?: boolean;
}
const {
  title = "Terrella",
  description = "Ray-traced relief maps of every country.",
  borders = false,
  spotlight = false,
  quality = false,
  spin = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Progressive-enhancement hook: flip no-js → js before paint so CSS can hide
        controls that only work with JavaScript (see .no-js rules in global.css).
        No JS → the class stays `no-js` and those controls never show. */}
    <script is:inline>
      document.documentElement.classList.replace("no-js", "js");
    </script>
    {/* Pre-paint tier guard: runs synchronously BEFORE the gallery paints, so a
        capable visitor is redirected to /globe with no flash of gallery, and an
        incapable/Lite visitor who deep-links /globe bounces straight back. This
        is the minimal gallery-vs-globe boundary of src/lib/capability.ts
        decideTier() — it can't import (it must run before the bundle), so it is
        deliberately kept tiny and mirrors only that boundary: the same WebGL2 +
        software-rasterizer floor `capable()` applies. The nuanced globe-vs-full
        decision (memory, network, reduced-motion) still runs in the page module. */}
    <script is:inline>
      (function () {
        try {
          var quality = localStorage.getItem("rg:quality") || "auto";
          var path = location.pathname;
          var atEntry = path === "/";
          var atGlobe = path === "/globe" || path === "/globe/";
          if (!atEntry && !atGlobe) return;

          // MUST mirror capability.ts `capable()` — WebGL2 present AND not a software
          // rasterizer. It cannot import it (this has to run before the bundle, which is the
          // whole reason it is is:inline), so the two are pinned against each other by
          // capability.test.ts, which executes THIS source rather than string-matching it.
          //
          // The software check used to be missing here, so a SwiftShader/llvmpipe visitor who
          // deep-linked /globe was never bounced: the page module would decide "gallery" while
          // this guard had already let the globe render. Reading both renderer strings covers
          // Chrome (truth in the debug extension, RENDERER masked) and Firefox (extension
          // deprecated, RENDERER unmasked).
          function capable() {
            try {
              var gl = document.createElement("canvas").getContext("webgl2");
              if (!gl) return false;
              var names = [];
              var ext = gl.getExtension("WEBGL_debug_renderer_info");
              if (ext) names.push(String(gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) || ""));
              names.push(String(gl.getParameter(gl.RENDERER) || ""));
              return !/swiftshader|llvmpipe|software|basic render|microsoft basic|softpipe|mesa offscreen/i.test(
                names.join(" "),
              );
            } catch (e) {
              return false;
            }
          }
          var conn = navigator.connection || {};
          var saveData =
            !!conn.saveData ||
            (typeof matchMedia === "function" &&
              matchMedia("(prefers-reduced-data: reduce)").matches);

          if (atGlobe) {
            // Can't run the globe here, or the user forced Lite → back to gallery.
            if (quality === "lite" || !capable()) location.replace("/");
            // Reaching the globe by ANY route counts as steered — not just by the auto-steer
            // below. The flag means "this session has seen the globe", so a later visit to /
            // is a deliberate choice (the ← Gallery link) and must not be bounced straight
            // back. Writing it only on the auto-steer path made ← Gallery a no-op for anyone
            // who deep-linked /globe or picked Globe/Full in the view bar.
            else sessionStorage.setItem("rg:steered", "1");
            return;
          }
          // atEntry: steer capable visitors onto the globe, pessimistically.
          if (quality === "lite") return; // user forced the gallery
          if (sessionStorage.getItem("rg:steered")) return; // steer once per session
          if (!capable()) return; // no globe floor — same test capability.ts applies
          if (quality === "auto" && saveData) return; // respect data-saver on auto
          sessionStorage.setItem("rg:steered", "1");
          location.replace("/globe/");
        } catch (e) {
          /* never let the guard break the page */
        }
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-serif" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {
      /* The view bar — ONE floating pill for every view option, replacing the old
         stack of separate fabs. Toggle buttons (Borders, Spin) and the tier picker
         share a single visual system: filled = on. The hairline divider separates
         what-the-globe-shows from what-tier-you-get. */
      (borders || spotlight || quality || spin) && (
        // `is-collapsible` must track the toggle's own render condition EXACTLY. Without it the
        // phone media query hid .view-bar-items on every page, including hero pages that render
        // no trigger — leaving the Focus button unreachable with nothing on screen to restore it.
        <div class:list={["view-bar", quality && "is-collapsible"]}>
          {/* Phone-only collapse. Rendered only where the tier picker is — that segment is what
              makes the bar wide, and on a hero page the bar is a single Focus button, where
              collapsing would cost a tap and save nothing. Hidden by CSS above the breakpoint. */}
          {quality && (
            <button
              type="button"
              class="view-bar-toggle"
              id="view-bar-toggle"
              aria-expanded="false"
              aria-controls="view-bar-items"
              aria-label="View options"
              title="View options"
            >
              {/* viewBox cropped to the ink (paths span 1.2–14.8 once the 1.6 stroke is counted),
                  not the nominal 0 0 16 16 — otherwise a quarter of the box is margin and this
                  renders visibly smaller than the credit ⓘ sharing the collapsed pill with it. */}
              <svg
                viewBox="1 1 14 14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M2 4.5h4.2M10.8 4.5h3.2M2 11.5h2.2M8.8 11.5h5.2" />
                <circle cx="8.5" cy="4.5" r="1.9" />
                <circle cx="6.5" cy="11.5" r="1.9" />
              </svg>
            </button>
          )}
          <div class="view-bar-items" id="view-bar-items" role="group" aria-label="View options">
          {borders && (
            <button type="button" id="border-toggle" aria-pressed="false" title="Country borders">
              Borders
            </button>
          )}
          {spotlight && (
            <button
              type="button"
              id="spotlight-toggle"
              aria-pressed="false"
              title="Dim everything but this country"
            >
              Focus
            </button>
          )}
          {spin && (
            <button type="button" id="spin-toggle" aria-pressed="false" title="Toggle globe auto-rotate">
              Spin
            </button>
          )}
          {(borders || spotlight || spin) && quality && <span class="view-bar-divider" aria-hidden="true" />}
          {/* Tooltips describe what each tier DOES TODAY, not what the architecture plans for it.
              `currentTier()` has exactly one behavioural read in the whole site — globe.astro's
              `spinning` — so Full currently buys idle rotation and nothing else. Saying "3D
              terrain" here would advertise a promise the site does not yet keep. Revisit when
              something else reads the tier. */}
          {quality && (
            <div class="quality-fab" role="radiogroup" aria-label="Experience quality">
              <button
                type="button"
                data-quality="lite"
                aria-pressed="false"
                title="Still renders only — leaves the globe"
              >
                Lite
              </button>
              <button type="button" data-quality="globe" aria-pressed="false" title="Interactive globe">
                Globe
              </button>
              <button
                type="button"
                data-quality="full"
                aria-pressed="false"
                title="Interactive globe, auto-rotating when idle"
              >
                Full
              </button>
            </div>
          )}
          </div>
        </div>
      )
    }
  </body>
</html>

<script>
  // Shared border toggle — the floating control lives in the layout so it's
  // always reachable, and its state persists across gallery <-> detail nav.
  // Off by default: borders are an opt-in overlay, so a fresh visitor gets the
  // clean relief (and, on the globe, never downloads the border geometry — the
  // globe adds that source lazily on the first "rg:borders" on-event below).
  const borderButton = document.getElementById("border-toggle") as HTMLButtonElement | null;
  const KEY = "rg:borders";
  if (borderButton) {
    const applyBorderState = (on: boolean) => {
      borderButton.setAttribute("aria-pressed", String(on));
      document.body.classList.toggle("borders-on", on);
    };
    applyBorderState(localStorage.getItem(KEY) === "1");
    borderButton.addEventListener("click", () => {
      const on = borderButton.getAttribute("aria-pressed") !== "true";
      applyBorderState(on);
      localStorage.setItem(KEY, on ? "1" : "0");
      // Pages with map layers (the globe) react to this, not to the raw click —
      // it keeps the layout as the single writer of the persisted state.
      document.dispatchEvent(new CustomEvent("rg:borders", { detail: { on } }));
    });
  }

  // View-bar collapse — phone-only, and the only toggle here whose effect is purely CSS: the
  // class drives a `display: none` that lives inside a media query, so above the breakpoint the
  // state is carried but inert. Persisted like the others rather than reset per page, because the
  // bar is a thing you open to use for a while (flip Borders, try a tier) and re-collapsing it on
  // every navigation would punish exactly that. Default is CLOSED — on a phone the pill covers
  // the globe, which is the content.
  const viewBar = document.querySelector<HTMLElement>(".view-bar");
  const viewBarToggle = document.getElementById("view-bar-toggle") as HTMLButtonElement | null;
  const VIEW_BAR_KEY = "rg:viewbar";
  if (viewBar && viewBarToggle) {
    const applyViewBarState = (open: boolean) => {
      viewBar.classList.toggle("is-open", open);
      // Pages with corner chrome of their own react to this (the globe hides its scale bar), the
      // same layout-owns-the-state pattern as `borders-on` / `spotlight-on`. Needed because an
      // expanded bar is TALL on a narrow phone — measured 141 px, four rows, at 320 px — and no
      // fixed clearance constant can outrun something that grows with the viewport shrinking.
      document.body.classList.toggle("viewbar-open", open);
      viewBarToggle.setAttribute("aria-expanded", String(open));
    };
    applyViewBarState(localStorage.getItem(VIEW_BAR_KEY) === "1");
    viewBarToggle.addEventListener("click", () => {
      const open = viewBarToggle.getAttribute("aria-expanded") !== "true";
      applyViewBarState(open);
      localStorage.setItem(VIEW_BAR_KEY, open ? "1" : "0");
    });
  }

  // Focus toggle — dims + desaturates everything but the selected country and
  // strokes its boundary (the subject-spotlight overlay). Same pattern as borders:
  // layout owns the persisted state + the body class the hero pages style against.
  const spotlightButton = document.getElementById("spotlight-toggle") as HTMLButtonElement | null;
  const SPOTLIGHT_KEY = "rg:spotlight";
  if (spotlightButton) {
    const applySpotlightState = (on: boolean) => {
      spotlightButton.setAttribute("aria-pressed", String(on));
      document.body.classList.toggle("spotlight-on", on);
    };
    applySpotlightState(localStorage.getItem(SPOTLIGHT_KEY) === "1");
    spotlightButton.addEventListener("click", () => {
      const on = spotlightButton.getAttribute("aria-pressed") !== "true";
      applySpotlightState(on);
      localStorage.setItem(SPOTLIGHT_KEY, on ? "1" : "0");
    });
  }
</script>

<script>
  // Quality control (Lite / Globe / Full) — the persisted, always-reachable
  // override that beats the auto-probe. The active button reflects the CURRENT
  // experience (the gallery is "Lite"; on the globe it's Globe or Full by whether
  // the idle animation runs), so it reads as "what am I seeing" not "what did the
  // probe guess". A pick persists via setQuality and navigates to that tier's
  // canonical page; the head guard + globe module enforce it from there.
  import { setQuality, currentTier, type Quality } from "../lib/capability";

  const control = document.querySelector<HTMLElement>(".quality-fab");
  if (control) {
    const buttons = Array.from(control.querySelectorAll<HTMLButtonElement>("button"));
    const onGlobe = location.pathname === "/globe" || location.pathname === "/globe/";
    const active: Quality = !onGlobe ? "lite" : currentTier() === "full" ? "full" : "globe";
    for (const button of buttons) {
      const isActive = button.dataset.quality === active;
      button.classList.toggle("is-active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    }
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const choice = button.dataset.quality as Quality;
        setQuality(choice);
        // No sessionStorage juggling here on purpose. This used to clear "rg:steered" so a new
        // choice could steer the session again, but nothing needs that: every arrival at /globe
        // is already permitted by rg:quality alone, and every arrival at / with quality "lite"
        // returns early from the head guard. Clearing it only re-armed the auto-steer, which
        // then hijacked the next ← Gallery click.
        const target = choice === "lite" ? "/" : "/globe/";
        if (location.pathname === target) location.reload();
        else location.assign(target);
      });
    }
  }
</script>
