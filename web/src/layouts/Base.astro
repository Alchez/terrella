---
interface Props {
  title?: string;
  description?: string;
  borders?: boolean;
}
const {
  title = "Relief Globe",
  description = "Ray-traced relief maps of every country.",
  borders = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {
      borders && (
        <label class="borders-fab" title="Toggle country borders">
          <input type="checkbox" id="border-toggle" />
          <span>Borders</span>
        </label>
      )
    }
  </body>
</html>

<style is:global>
  :root {
    --bg: #e9e5da;
    --bg-2: #f3f0e8;
    --text: #2c2822;
    --muted: #6b6458;
    --line: #d6d0c2;
    --accent: #3a6e7d; /* deep-sea teal, from the hero ramp */
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 6px 18px rgba(0, 0, 0, 0.08);
    --serif: Georgia, "Times New Roman", serif;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1b1a16;
      --bg-2: #24221b;
      --text: #e7e2d5;
      --muted: #9a9384;
      --line: #35312a;
      --accent: #7cb8b8; /* shallow teal in the dark */
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 22px rgba(0, 0, 0, 0.45);
    }
  }

  * {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    font-family: var(--sans);
    color: var(--text);
    background: var(--bg);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  img {
    display: block;
    max-width: 100%;
  }
  a {
    color: var(--accent);
  }

  /* Floating, always-reachable border toggle (tall heroes scroll past a header
     control). Shown only when the page passes borders={true}. */
  .borders-fab {
    position: fixed;
    bottom: 1.2rem;
    right: 1.2rem;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.95rem;
    background: color-mix(in srgb, var(--bg-2) 92%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: var(--shadow);
    font-size: 0.9rem;
    color: var(--text);
    cursor: pointer;
    user-select: none;
  }
  .borders-fab input {
    accent-color: var(--accent);
    width: 1.05rem;
    height: 1.05rem;
    margin: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .borders-fab {
      transition: box-shadow 0.2s ease;
    }
  }
</style>

<script>
  // Shared border toggle — the floating control lives in the layout so it's
  // always reachable, and its state persists across gallery <-> detail nav.
  const cb = document.getElementById("border-toggle") as HTMLInputElement | null;
  const KEY = "rg:borders";
  if (cb) {
    const on = localStorage.getItem(KEY) === "1";
    cb.checked = on;
    document.body.classList.toggle("borders-on", on);
    cb.addEventListener("change", () => {
      document.body.classList.toggle("borders-on", cb.checked);
      localStorage.setItem(KEY, cb.checked ? "1" : "0");
    });
  }
</script>
