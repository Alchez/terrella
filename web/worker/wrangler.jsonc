{
  // Terrella's relief tile server. Deploy from this directory: `npx wrangler deploy`.
  //
  // The bucket is reached through a BINDING, not a URL — that is what keeps the archives
  // private (terrella-tiles has no custom domain and its r2.dev domain is disabled) and what
  // makes the internal range reads subrequests, which Cloudflare does not bill.
  //
  // It serves THREE pyramids: relief at `{z}/{x}/{y}.webp`, terrain-RGB at
  // `terrain/{z}/{x}/{y}.webp`, and country vector tiles at `countries/{z}/{x}/{y}.mvt`.
  // One binding, three object keys — see the vars block.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terrella-tiles",

  // Both off, for the same reason the site Worker has them off: a workers.dev or preview
  // hostname is a second public origin that serves the whole pyramid while sitting OUTSIDE
  // the zone — so zone Cache Rules, WAF rules and any future rate limit do not apply to it,
  // yet its requests still bill against the free tier. Set explicitly rather than left to
  // default: `workers_dev: false` alone makes wrangler warn about preview_urls on every
  // deploy, and a warning nobody can action is a warning everyone learns to skip.
  "workers_dev": false,
  "preview_urls": false,
  "main": "index.ts",
  // Kept current deliberately: the Protomaps worker this replaces still pins 2024-09-02.
  "compatibility_date": "2026-07-25",
  "observability": { "enabled": true },

  // A cache in FRONT of this Worker, which is a different thing from the `caches.default`
  // calls inside index.ts. Those run our code first and only then look; this one answers
  // before our code exists. Three consequences, in ascending order of why it is here:
  //
  //   - Read-through: a hit never invokes us. Worth ~5-10 ms of a ~470 ms warm tile — noise.
  //   - Tiered: every data center's cache is backed by a shared upper tier, and a fill lands
  //     in both. With ~100k tile addresses and low traffic, one visitor warming a tile for
  //     the whole network is the only lever that touches our real weak spot, hit rate. The
  //     Cache API is local to one data center and cannot do this at all.
  //   - Request collapsing: N simultaneous requests for one tile run us ONCE. Every first
  //     visitor asks for the same default-view tiles, so this matters exactly once — the day
  //     the site is posted somewhere — and it cannot be added under load.
  //
  // Cost is nothing: a hit is billed at the same per-request rate we already pay today, since
  // our Cache API hits invoke the Worker anyway. Which is precisely why this block must NEVER
  // be copied into the site Worker — see the warning in ../wrangler.jsonc.
  //
  // `cross_version_cache` is deliberately absent (default: off, version in the cache key).
  // The docs frame version-keying as a hit-rate problem to fix; for a Worker deployed a
  // handful of times a year it is a feature — a deploy invalidates for free, which is what
  // keeps the ALLOWED_ORIGIN note below true and stops a year-long 404 outliving a re-cut.
  "cache": { "enabled": true },

  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "terrella-tiles",
      // `wrangler dev` reads the same bucket — there is only one archive, and it is immutable.
      "preview_bucket_name": "terrella-tiles"
    }
  ],

  "vars": {
    // A re-cut ships under a NEW key rather than overwriting the old one. Two reasons: the swap
    // becomes atomic and reversible by editing this one line, and a warm isolate holding directory
    // offsets from the previous archive can never read them against different bytes. Delete the
    // superseded object only after the new one is verified live.
    //
    // `planet.pmtiles` is the PNG pyramid this replaced; `-v2` is the WebP q95 cut.
    "ARCHIVE_KEY": "planet-v2.pmtiles",
    // The Tier-3 elevation pyramid, served under the `/terrain/` prefix by the same Worker out of
    // the same bucket. Same new-key-per-cut convention as above, and the same reason: a warm
    // isolate holding directory offsets from one cut must never read them against another's bytes.
    //
    // A SECOND KEY RATHER THAN A SECOND BINDING — both objects live in `terrella-tiles`, so a
    // second `r2_buckets` entry would only duplicate the bucket name and give it somewhere to
    // drift out of step with the first.
    "TERRAIN_ARCHIVE_KEY": "terrain-v1.pmtiles",
    // The country VECTOR pyramid, served under `/countries/` by the same Worker out of the same
    // bucket — a third key, not a third binding, for the reason stated above. Same
    // new-key-per-cut convention: this one is re-cut whenever the simplification settings in
    // pipeline/compose/countries_pmtiles.py change, and its recipe sidecar records which.
    //
    // It is the one SPARSE archive: a missing tile is ocean, not a packaging fault, so the router
    // answers 204 for it and 404 for the two raster pyramids. See `missingTileStatus`.
    "COUNTRIES_ARCHIVE_KEY": "countries-v1.pmtiles",
    // The site's own origin. MapLibre uploads tiles as WebGL textures, so a cross-origin
    // tile without CORS taints the canvas and never draws — this must stay in step with
    // the hostname in web/package.json's `build:deploy`.
    //
    // Narrowed from "*" once the site went live. This stops another origin's JavaScript
    // embedding our globe; it is NOT hotlink protection, since a server-side proxy never
    // sends Origin and never reads the header. The point is the free tier's ~2,500
    // cold-visit/day ceiling, not secrecy.
    //
    // Changing this still needs a redeploy but no purge — for a different reason than it
    // used to. Workers Caching stores the response we return, CORS header and all, so the
    // old "applied on the way out and never cached" no longer holds. What holds instead:
    // we set `Vary: Origin` and Workers Caching honours every header name with no allowlist,
    // so another origin is a separate variant that misses and gets adjudicated fresh; and the
    // Worker version is in the cache key, so a redeploy IS the purge. Both halves depend on
    // `cross_version_cache` staying off.
    "ALLOWED_ORIGIN": "https://terrella.alchez.dev"
  }
}
