# Asset store paths for the Astro dev server (DEV-ONLY — the dev middleware serves
# /heroes, /borders and /pmtiles straight off these directories; nginx serves them in
# prod, and the static build never reads them).
#
# Required for `astro dev`: copy this file to .env and set each to your local path.
# There is no fallback — an unset var fails the dev server with a clear message.
# (`astro build` does not need them.)
HERO_STORE=/path/to/maps/blender/renders/variants
BORDERS_STORE=/path/to/maps/data/work/borders
# PMTILES_STORE holds the packaged archive (planet.pmtiles) — the /pmtiles route
# serves it with byte-range support; it is the sole relief tile source.
PMTILES_STORE=/path/to/maps/data/work/planet_tiles
