# build output
dist/
# generated types
.astro/
# The gallery manifest, generated from whichever heroes this machine's render store holds. It sits
# here rather than in the root ignore because that one is anchored to the render store at `/data/`
# and no longer reaches this directory.
src/data/countries.json

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
public/dev-assets/
public/caps/

# ?perf snapshot exports (dev-only endpoint in astro.config.ts) — captures, not source
.perf/

# Vitest browser-mode failure artifacts. Note `__screenshots__/<spec>.browser.test.ts/` is a
# DIRECTORY named like a spec — anything globbing *.test.ts must filter to files.
.vitest-attachments/
**/__screenshots__/

# `wrangler check startup` writes its flamegraph beside the Worker it profiled.
*.cpuprofile
