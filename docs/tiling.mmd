%% Tiling and serving — how the shaded 3857 master becomes a served tile pyramid.
%% Companion to pipeline-detail.mmd, which compresses all of this into its single
%% "gdal raster tile" node (T2). Update both when the tiling stage changes.

flowchart TD

  M[("Shaded planet master — tile/shade_planet.py<br/>planet_rgb.tif, EPSG:3857, uint8 RGB<br/>131072 x 131072 (full Mercator square, Antarctica included), 305.7483 m/px<br/>z8-NATIVE: width = 512 x 2^8, so its pixels ARE the z8 grid")]

  subgraph CUT["gdal raster tile — build_tiles (one call, two phases)"]
    P1["Phase 1 — max-zoom cut (z8)<br/>each z8 tile = the source region it covers, 512 px<br/>source is already 3857, grid-aligned, at z8 resolution, so this is a<br/>pure copy: --resampling=cubic is INERT here (proven byte-identical to nearest)"]
    Z8["z8 tiles — 65,536 (the full 256 x 256 square; the Antarctica fill closed the clipped band)<br/>the finest level; holds the whole master, no loss yet"]
    P2["Phase 2 — recursive overviews (z7 down to z0)<br/>each tile built from the 2x2 tiles BELOW it, never from the source<br/>(proven: tiling with vs without source overviews is byte-identical,<br/>which is why the old gdaladdo step was deleted)<br/>--overview-resampling=cubic pins an otherwise-undocumented default;<br/>cubic ringing compounds across the 8 levels"]
  end

  subgraph OUT["Tile directory — the addressing IS the API"]
    DIR["planet_tiles/tiles/&lt;z&gt;/&lt;x&gt;/&lt;y&gt;.png<br/>XYZ convention (y counts down from the top-left)<br/>87,381 tiles, ~4x per level (z0=1, ... z8=65,536)<br/>--skip-blank omits empty tiles; --webviewer=none (no leaflet/ol junk)<br/>cuts CLEAN each time (no --resume — a truncated png can't survive);<br/>guarded by a tiles.done sentinel; staged in tiles_new, swapped atomically,<br/>tiles_old kept as rollback"]
  end

  subgraph SERVE["Serving"]
    PM["PMTiles — tile/pack_pmtiles.py then pmtiles convert<br/>dir → MBTiles (blobs byte-moved, XYZ→TMS row flip) → planet.pmtiles, 16 GB<br/>~5% duplicate tiles collapsed; verified byte-identical vs the directory<br/>ONE object; the tile directory it was built from is not deployed"]
    TS["Tile server — opens the archive, answers one z/x/y at a time<br/>dev: /tiles middleware in web/astro.config.ts, over a local file<br/>prod: a Worker, over an R2 object (see HISTORY, deploy target moves to R2)<br/>the browser NEVER ranges the archive: Workers Caching strips Range and<br/>would fetch all 16 GB per tile, and a 16 GB object is past the 512 MB cache ceiling"]
    ML["MapLibre GL raster source — globe.astro (LIVE today)<br/>tiles &lt;PUBLIC_TILE_BASE&gt;&lt;z&gt;/&lt;x&gt;/&lt;y&gt;.png, minzoom 0 maxzoom 8<br/>base unset = same-origin /tiles/ (what astro dev serves); a deploy points it at the Worker<br/>tileSize:256 declared + 512 px assets = @2x retina crispness<br/>the globe projection re-warps the mercator tiles onto a sphere, GPU-side<br/>(WebMercatorQuad is dictated by this renderer, not chosen for itself)"]
  end

  M --> P1
  P1 --> Z8
  Z8 --> P2
  P2 --> DIR
  DIR --> PM
  PM --> TS
  TS --> ML

  classDef done fill:#dcefe2,stroke:#2e7d4f,color:#1a3a28
  classDef next fill:#fdf3d7,stroke:#b8860b,color:#4a3a10

  class M,P1,Z8,P2,DIR,ML,PM done
  class TS next
