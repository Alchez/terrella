flowchart TD

  subgraph SRC["Where the data comes from"]
    S1["Copernicus GLO-30<br/>satellite-measured land heights<br/>(detail: ~30 m per pixel)"]
    S2["GEBCO 2026<br/>worldwide seafloor depths<br/>(detail: ~450 m per pixel)"]
    S3["Natural Earth<br/>country outlines and borders"]
  end

  subgraph ACQ["Getting it — done"]
    D1["Downloader script<br/>fetches the 979 one-degree squares<br/>around India; safe to re-run anytime"]
    R1[("Land heights<br/>979 files, part of 34 GB")]
    R2[("Water map<br/>per pixel: dry / sea / lake / river")]
    R3[("Seafloor depths<br/>one file for the whole region")]
  end

  S1 --> D1
  D1 --> R1
  D1 --> R2
  S2 -->|downloaded by hand from their site| R3

  subgraph FUSE["Combining land and sea — done"]
    F["Fusion script — makes one seamless height map:<br/>land keeps its measured height,<br/>sea floor comes from GEBCO, always below zero,<br/>sea-level lagoons and deltas count as sea"]
    O1[("India height map<br/>one elevation value per ~90 m,<br/>Himalaya summits to ocean trenches")]
    O2[("Sea/land map<br/>remembers which pixels are sea —<br/>later picks sand vs teal coloring")]
  end

  R1 --> F
  R2 --> F
  R3 --> F
  F --> O1
  F --> O2

  subgraph HERO["Country portraits — India done; every country = Phase 1, next"]
    P["Prepare for rendering:<br/>undo the map stretch (projection),<br/>shrink to a renderable size"]
    B["Blender 3D scene:<br/>heights become sculpted terrain,<br/>a low sun casts soft real shadows,<br/>color from height on land, depth at sea"]
    H8["8K portrait of India"]
    OV["Borders drawn onto the finished image:<br/>solid white between countries, dashed for<br/>disputed and sea boundaries; positions<br/>double-checked against the coastline"]
    HF[("Final bordered portrait, plus a<br/>separate border-only layer so the<br/>website can toggle borders off")]
  end

  O1 --> P
  O2 --> P
  P --> B
  B --> H8
  H8 --> OV
  S3 --> OV
  OV --> HF

  subgraph TILES["Zoomable world — later"]
    T1["Fast shading that imitates<br/>the Blender look without ray tracing"]
    T2["Map tiles at 9 zoom levels,<br/>packed into a single file"]
  end

  O1 -.-> T1
  O2 -.-> T1
  T1 -.-> T2

  subgraph SITE["The website — later"]
    W["Three versions, picked to fit your device:<br/>photo gallery / spinning globe / full 3D globe"]
  end

  T2 -.-> W
  HF -.-> W
  S3 -.->|clickable borders| W

  classDef ext fill:#dbe9f6,stroke:#3572a5,color:#173a5e
  classDef done fill:#dcefe2,stroke:#2e7d4f,color:#1a3a28
  classDef next fill:#fdf3d7,stroke:#b8860b,color:#4a3a10
  classDef plan fill:#eceff1,stroke:#78909c,color:#37474f

  class S1,S2,S3 ext
  class D1,R1,R2,R3 done
  class F,O1,O2 done
  class P,B,H8,OV,HF done
  class T1,T2,W plan
